---
---
<section>
  <div class="slide-content" style="background:#121212; width:100%; height:100%; overflow:hidden; font-family:'Inter',sans-serif;">
    <div style="position:relative; width:100%; height:100%; display:flex; align-items:center; justify-content:center;">

      <!-- Fondo: radial sutil en amarillo claro tirando a blanco -->
      <div style="position:absolute; inset:0; background:radial-gradient(ellipse 65% 65% at 50% 50%, rgba(255,247,205,0.06) 0%, transparent 65%);"></div>
      
      <!-- Bordes luminosos -->
      <div style="position:absolute; top:0; left:0; right:0; height:3px; background:linear-gradient(to right, transparent, #FFF7CD 40%, #FAF0B5 60%, transparent);"></div>
      <div style="position:absolute; bottom:0; left:0; right:0; height:3px; background:linear-gradient(to right, transparent, #FFF7CD 40%, #FAF0B5 60%, transparent);"></div>

      <!-- Número de slide (superior derecho) -->
      <div style="position:absolute; top:28px; right:48px; font-size:11px; color:rgba(167,159,142,0.3); font-weight:600; letter-spacing:0.15em;">15 / 15</div>

      <div style="position:relative; z-index:10; text-align:center; max-width:700px; padding:0 48px;">

        <!-- Logo Caudex completo (árbol + tipografía) -->
        <img src="/images/caudex.svg" alt="CAUDEX" style="height:150px; width:auto; margin:0 auto 20px; display:block;" />
        <div style="width:80px; height:3px; background:linear-gradient(to right, #FFF7CD, #FAF0B5); margin:0 auto 24px; border-radius:2px;"></div>

        <p style="font-size:18px; color:#a79f8e; margin:0 0 40px 0; line-height:1.5;">Construimos el software que Argentina necesita.<br/>Sin licencias extranjeras. Sin burocracia.</p>

        <!-- Links / contacto -->
        <div style="display:flex; justify-content:center; gap:20px; flex-wrap:wrap;">
          <div style="padding:10px 20px; border:1px solid rgba(255,247,205,0.3); background:rgba(255,247,205,0.05);">
            <span style="font-size:12px; color:#FFF7CD; font-family:'JetBrains Mono',monospace; letter-spacing:0.05em;">github.com/caudex-nox</span>
          </div>
          <div style="padding:10px 20px; border:1px solid rgba(255,255,255,0.08); background:rgba(255,255,255,0.02);">
            <span style="font-size:12px; color:#a79f8e; font-family:'JetBrains Mono',monospace; letter-spacing:0.05em;">Santa Fe, Argentina · 2026</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
