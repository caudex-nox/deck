---
---
<section>
  <div class="slide-content" style="background:#121212; width:100%; height:100%; overflow:hidden; font-family:'Inter',sans-serif;">
    <div style="position:relative; width:100%; height:100%; display:flex; align-items:center; justify-content:center;">

      <!-- Número decorativo fondo -->
      <div style="position:absolute; right:-10px; bottom:20px; font-size:260px; font-weight:900; color:rgba(255,247,205,0.02); line-height:1; user-select:none;">3</div>

      <!-- Número de slide (superior derecho) -->
      <div style="position:absolute; top:28px; right:48px; font-size:11px; color:rgba(167,159,142,0.3); font-weight:600; letter-spacing:0.15em;">09 / 15</div>

      <div style="position:relative; z-index:10; max-width:960px; width:100%; padding:0 64px;">

        <p style="font-size:11px; color:#FFF7CD; letter-spacing:0.25em; text-transform:uppercase; font-weight:600; margin:0 0 16px 0;">Previsión de Ventas · Kanon</p>
        <h2 style="font-size:40px; font-weight:800; color:#FFF7CD; margin:0 0 32px 0; letter-spacing:-0.02em;">Crecimiento <span style="color:#FAF0B5;">proyectado</span></h2>

        <!-- 3 años -->
        <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:2px; margin-bottom:24px;">

          <!-- Año 1 -->
          <div style="padding:28px 24px; background:rgba(255,247,205,0.08); border:1px solid rgba(255,247,205,0.35); position:relative; overflow:hidden;">
            <div style="position:absolute; top:0; left:0; right:0; height:3px; background:#FFF7CD;"></div>
            <div style="font-size:11px; color:#FFF7CD; letter-spacing:0.2em; font-weight:600; margin-bottom:8px;">AÑO 1</div>
            <div style="font-size:64px; font-weight:900; color:#FFF7CD; line-height:1; margin-bottom:8px;">3</div>
            <div style="font-size:13px; color:#FFF7CD; margin-bottom:8px; font-weight:500;">clientes institucionales</div>
            <div style="font-size:12px; color:#a79f8e; line-height:1.5;">Piloto bonificado 30 días · Gran Santa Fe</div>
          </div>

          <!-- Año 2 -->
          <div style="padding:28px 24px; background:rgba(255,247,205,0.04); border:1px solid rgba(255,247,205,0.2); position:relative; overflow:hidden;">
            <div style="position:absolute; top:0; left:0; right:0; height:3px; background:rgba(255,247,205,0.4);"></div>
            <div style="font-size:11px; color:#FAF0B5; letter-spacing:0.2em; font-weight:600; margin-bottom:8px;">AÑO 2</div>
            <div style="font-size:64px; font-weight:900; color:#FFF7CD; line-height:1; margin-bottom:8px;">5</div>
            <div style="font-size:13px; color:#FFF7CD; margin-bottom:8px; font-weight:500;">clientes institucionales</div>
            <div style="display:inline-block; padding:3px 8px; background:rgba(255,247,205,0.12); border:1px solid rgba(255,247,205,0.3); font-size:11px; color:#FFF7CD; font-weight:700;">+66%</div>
          </div>

          <!-- Año 3 -->
          <div style="padding:28px 24px; background:rgba(255,255,255,0.02); border:1px solid rgba(255,247,205,0.1); position:relative; overflow:hidden;">
            <div style="position:absolute; top:0; left:0; right:0; height:3px; background:rgba(255,247,205,0.2);"></div>
            <div style="font-size:11px; color:#a79f8e; letter-spacing:0.2em; font-weight:600; margin-bottom:8px;">AÑO 3</div>
            <div style="font-size:64px; font-weight:900; color:#FAF0B5; line-height:1; margin-bottom:8px;">6</div>
            <div style="font-size:13px; color:#a79f8e; margin-bottom:8px; font-weight:500;">clientes institucionales</div>
            <div style="display:inline-block; padding:3px 8px; background:rgba(255,255,255,0.04); border:1px solid rgba(255,247,205,0.15); font-size:11px; color:#a79f8e; font-weight:700;">+20%</div>
          </div>
        </div>

        <!-- Fuente del cálculo -->
        <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:16px;">
          <div style="text-align:center; padding:12px; border-top:1px solid rgba(255,247,205,0.2);">
            <div style="font-size:18px; font-weight:800; color:#FFF7CD;">1.675</div>
            <div style="font-size:11px; color:#a79f8e; margin-top:4px;">escuelas técnicas nacionales</div>
          </div>
          <div style="text-align:center; padding:12px; border-top:1px solid rgba(255,247,205,0.15);">
            <div style="font-size:18px; font-weight:800; color:#FFF7CD;">33</div>
            <div style="font-size:11px; color:#a79f8e; margin-top:4px;">mercado accesible Gran Santa Fe</div>
          </div>
          <div style="text-align:center; padding:12px; border-top:1px solid rgba(255,255,255,0.06);">
            <div style="font-size:18px; font-weight:800; color:#a79f8e;">10%</div>
            <div style="font-size:11px; color:#a79f8e; margin-top:4px;">tasa de captura conservadora</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
