---
---
<!-- Slide 09 — Proyección de ventas Kanon — números cuentan hacia arriba -->
<section id="slide-09">
  <div class="slide-content" style="background:#121212; width:100%; height:100%; overflow:hidden; font-family:'Inter',sans-serif;">
    <div style="position:relative; width:100%; height:100%; display:flex; align-items:center; justify-content:center;">

      <div style="position:absolute; top:28px; right:48px; font-size:11px; color:rgba(167,159,142,0.3); font-weight:600; letter-spacing:0.15em;">13 / 20</div>

      <div style="position:relative; z-index:10; max-width:960px; width:100%; padding:0 64px;">

        <p class="s09-label" style="font-size:11px; color:#FFF7CD; letter-spacing:0.25em; text-transform:uppercase; font-weight:600; margin:0 0 12px 0; opacity:0;">Previsión de Ventas · Kanon</p>
        <h2 class="s09-title" style="font-size:44px; font-weight:800; color:#FFF7CD; margin:0 0 28px 0; letter-spacing:-0.02em; opacity:0;">Crecimiento <span style="color:#FAF0B5;">proyectado</span></h2>

        <!-- 3 años -->
        <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:2px; margin-bottom:22px;">

          <div class="s09-year" style="padding:24px; background:rgba(255,247,205,0.08); border:1px solid rgba(255,247,205,0.35); position:relative; overflow:hidden; opacity:0;">
            <div style="position:absolute; top:0; left:0; right:0; height:3px; background:#FFF7CD;"></div>
            <div style="font-size:10px; color:#FFF7CD; letter-spacing:0.2em; font-weight:600; margin-bottom:6px;">AÑO 1</div>
            <div class="s09-num" data-target="3" style="font-size:60px; font-weight:900; color:#FFF7CD; line-height:1; margin-bottom:6px;">0</div>
            <div style="font-size:14px; color:#FFF7CD; margin-bottom:6px; font-weight:500;">clientes</div>
            <div style="font-size:12px; color:#a79f8e; line-height:1.4;">Piloto · Gran Santa Fe</div>
          </div>

          <div class="s09-year" style="padding:24px; background:rgba(255,247,205,0.04); border:1px solid rgba(255,247,205,0.2); position:relative; overflow:hidden; opacity:0;">
            <div style="position:absolute; top:0; left:0; right:0; height:3px; background:rgba(255,247,205,0.4);"></div>
            <div style="font-size:10px; color:#FAF0B5; letter-spacing:0.2em; font-weight:600; margin-bottom:6px;">AÑO 2</div>
            <div class="s09-num" data-target="5" style="font-size:60px; font-weight:900; color:#FFF7CD; line-height:1; margin-bottom:6px;">0</div>
            <div style="font-size:14px; color:#FFF7CD; margin-bottom:6px; font-weight:500;">clientes</div>
            <div style="display:inline-block; padding:3px 8px; background:rgba(255,247,205,0.12); border:1px solid rgba(255,247,205,0.3); font-size:11px; color:#FFF7CD; font-weight:700;">+66%</div>
          </div>

          <div class="s09-year" style="padding:24px; background:rgba(255,255,255,0.02); border:1px solid rgba(255,247,205,0.1); position:relative; overflow:hidden; opacity:0;">
            <div style="position:absolute; top:0; left:0; right:0; height:3px; background:rgba(255,247,205,0.2);"></div>
            <div style="font-size:10px; color:#a79f8e; letter-spacing:0.2em; font-weight:600; margin-bottom:6px;">AÑO 3</div>
            <div class="s09-num" data-target="6" style="font-size:60px; font-weight:900; color:#FAF0B5; line-height:1; margin-bottom:6px;">0</div>
            <div style="font-size:14px; color:#a79f8e; margin-bottom:6px; font-weight:500;">clientes</div>
            <div style="display:inline-block; padding:3px 8px; background:rgba(255,255,255,0.04); border:1px solid rgba(255,247,205,0.15); font-size:11px; color:#a79f8e; font-weight:700;">+20%</div>
          </div>
        </div>

        <!-- Stats fuente de cálculo -->
        <div class="s09-stats" style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:16px; opacity:0;">
          <div style="text-align:center; padding:10px; border-top:1px solid rgba(255,247,205,0.2);">
            <div style="font-size:17px; font-weight:800; color:#FFF7CD;">1.675</div>
            <div style="font-size:12px; color:#a79f8e; margin-top:3px;">base nacional</div>
          </div>
          <div style="text-align:center; padding:10px; border-top:1px solid rgba(255,247,205,0.15);">
            <div style="font-size:17px; font-weight:800; color:#FFF7CD;">33</div>
            <div style="font-size:12px; color:#a79f8e; margin-top:3px;">mercado accesible</div>
          </div>
          <div style="text-align:center; padding:10px; border-top:1px solid rgba(255,255,255,0.06);">
            <div style="font-size:17px; font-weight:800; color:#a79f8e;">10%</div>
            <div style="font-size:12px; color:#a79f8e; margin-top:3px;">captura conservadora</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { animate } from "motion";
  const slide = document.getElementById("slide-09");
  let yearPulseRunning = false;

  function countUp(el, target, duration = 800) {
    const start = 0;
    const startTime = performance.now();
    function step(currentTime) {
      const elapsed = currentTime - startTime;
      const progress = Math.min(elapsed / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3); // ease-out cubic
      el.textContent = Math.round(start + (target - start) * eased).toString();
      if (progress < 1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }

  function runSlide09Animations() {
    if (!slide) return;

    const label = slide.querySelector(".s09-label");
    if (label) animate(label, { opacity: [0, 1], y: [-8, 0] }, { duration: 0.4 });

    const title = slide.querySelector(".s09-title");
    if (title) animate(title, { opacity: [0, 1], y: [-8, 0] }, { duration: 0.5, delay: 0.1, ease: [0.16, 1, 0.3, 1] });

    // Tarjetas de año entran con scale y luego los números cuentan
    const years = slide.querySelectorAll(".s09-year");
    years.forEach((year, i) => {
      animate(year, { opacity: [0, 1], y: [20, 0] }, { duration: 0.55, delay: 0.2 + i * 0.15, ease: [0.16, 1, 0.3, 1] })
        .then(() => {
          const numEl = year.querySelector(".s09-num");
          const target = parseInt(numEl?.getAttribute("data-target") || "0");
          if (numEl) countUp(numEl, target, 600);
        });
    });

    const stats = slide.querySelector(".s09-stats");
    if (stats) animate(stats, { opacity: [0, 1], y: [10, 0] }, { duration: 0.5, delay: 0.85 });

    yearPulseRunning = true;
    runYearPulse();
  }

  async function runYearPulse() {
    const years = Array.from(slide?.querySelectorAll(".s09-year") || []);
    while (yearPulseRunning && years.length) {
      for (const year of years) {
        if (!yearPulseRunning) return;
        await animate(
          year,
          {
            borderColor: ["rgba(255,247,205,0.2)", "rgba(255,247,205,0.9)", "rgba(255,247,205,0.2)"],
            boxShadow: ["0 0 0 rgba(255,247,205,0)", "0 0 24px rgba(255,247,205,0.28)", "0 0 0 rgba(255,247,205,0)"]
          },
          { duration: 1.15, ease: [0.22, 1, 0.36, 1] }
        ).finished;
        await new Promise(resolve => setTimeout(resolve, 260));
      }
      await new Promise(resolve => setTimeout(resolve, 2600));
    }
  }

  slide?.addEventListener("slide:enter", runSlide09Animations);
  slide?.addEventListener("slide:leave", () => {
    yearPulseRunning = false;
  });
  if (slide?.closest("section.present") || slide?.classList.contains("present")) {
    runSlide09Animations();
  }
</script>
