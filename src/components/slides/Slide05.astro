---
---
<!-- Slide 05 — Mercado Objetivo / Segmentos — movida al lugar correcto de la sección 2 -->
<section id="slide-05">
  <div class="slide-content" style="background:#121212; width:100%; height:100%; overflow:hidden; font-family:'Inter',sans-serif;">
    <div style="position:relative; width:100%; height:100%; display:flex; align-items:center; justify-content:center;">

      <div style="position:absolute; top:28px; right:48px; font-size:11px; color:rgba(167,159,142,0.3); font-weight:600; letter-spacing:0.15em;">09 / 20</div>

      <div style="position:relative; z-index:10; max-width:960px; width:100%; padding:0 64px; display:grid; grid-template-columns:1fr 1fr; gap:56px; align-items:center;">

        <!-- Columna izquierda -->
        <div>
          <p class="s05-label" style="font-size:11px; color:#FFF7CD; letter-spacing:0.25em; text-transform:uppercase; font-weight:600; margin:0 0 14px 0; opacity:0;">Mercado Objetivo</p>
          <h2 class="s05-title" style="font-size:44px; font-weight:800; color:#FFF7CD; margin:0 0 18px 0; line-height:1.1; letter-spacing:-0.02em; opacity:0;">Dos segmentos.<br/><span style="color:#FAF0B5;">Un foco.</span></h2>
          <p class="s05-sub" style="font-size:14px; color:#a79f8e; line-height:1.6; margin:0 0 28px 0; opacity:0;">Segmentación diferenciada con productos específicos para cada nicho.</p>

          <!-- Stat grande -->
          <div class="s05-stat" style="padding:22px; background:rgba(255,247,205,0.05); border-left:3px solid #FFF7CD; opacity:0;">
            <div style="font-size:52px; font-weight:900; color:#FFF7CD; line-height:1; margin-bottom:6px;">167</div>
            <div style="font-size:13px; color:#FFF7CD; font-weight:500; margin-bottom:2px;">escuelas técnicas en Santa Fe</div>
            <div style="font-size:11px; color:#a79f8e;">Consumo aparente · INDEC + Ministerio de Educación</div>
          </div>
        </div>

        <!-- Columna derecha: segmentos -->
        <div style="display:flex; flex-direction:column; gap:14px;">

          <div class="s05-seg" style="padding:22px; background:rgba(255,247,205,0.05); border:1px solid rgba(255,247,205,0.25); opacity:0;">
            <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:10px;">
              <div>
                <div style="font-size:10px; color:#FFF7CD; letter-spacing:0.15em; font-weight:600; margin-bottom:4px;">SEGMENTO A</div>
                <div style="font-size:17px; font-weight:700; color:#FFF7CD;">Instituciones Educativas</div>
              </div>
              <span style="padding:4px 10px; background:#FFF7CD; font-size:10px; color:#121212; font-weight:700; flex-shrink:0; margin-left:8px;">KANON</span>
            </div>
            <p style="font-size:12px; color:#a79f8e; margin:0;">Secundarias técnicas, institutos ETP, centros de formación profesional.</p>
          </div>

          <div class="s05-seg" style="padding:22px; background:rgba(255,255,255,0.03); border:1px solid rgba(255,247,205,0.15); opacity:0;">
            <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:10px;">
              <div>
                <div style="font-size:10px; color:#FAF0B5; letter-spacing:0.15em; font-weight:600; margin-bottom:4px;">SEGMENTO B</div>
                <div style="font-size:17px; font-weight:700; color:#FFF7CD;">PyMEs y Profesionales</div>
              </div>
              <span style="padding:4px 10px; background:rgba(255,247,205,0.1); border:1px solid rgba(255,247,205,0.3); font-size:10px; color:#FFF7CD; font-weight:700; flex-shrink:0; margin-left:8px;">ORESTES</span>
            </div>
            <p style="font-size:12px; color:#a79f8e; margin:0;">Micro y pequeñas empresas que necesitan gestión de datos sin licencias en USD.</p>
          </div>

          <div class="s05-seg" style="padding:12px 16px; border-left:2px solid rgba(255,247,205,0.25); background:rgba(255,255,255,0.02); opacity:0;">
            <p style="font-size:12px; color:#a79f8e; margin:0; font-style:italic;">Precios en pesos · SaaS · Sin instalación local</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { animate } from "motion";
  const slide = document.getElementById("slide-05");

  function runSlide05Animations() {
    if (!slide) return;

    // Columna izq: elementos en cascada desde arriba
    const label = slide.querySelector(".s05-label");
    if (label) animate(label, { opacity: [0, 1], y: [-10, 0] }, { duration: 0.4, delay: 0.1 });

    const title = slide.querySelector(".s05-title");
    if (title) animate(title, { opacity: [0, 1], y: [-12, 0] }, { duration: 0.55, delay: 0.2, ease: [0.16, 1, 0.3, 1] });

    const sub = slide.querySelector(".s05-sub");
    if (sub) animate(sub, { opacity: [0, 1], y: [-8, 0] }, { duration: 0.4, delay: 0.3 });

    // Stat: número "cuenta" hacia arriba
    const stat = slide.querySelector(".s05-stat");
    if (stat) animate(stat, { opacity: [0, 1], x: [-20, 0] }, { duration: 0.6, delay: 0.35, ease: [0.16, 1, 0.3, 1] });

    // Segmentos desde la derecha con stagger
    const segs = slide.querySelectorAll(".s05-seg");
    segs.forEach((s, i) => {
      animate(s, { opacity: [0, 1], x: [30, 0] }, { duration: 0.55, delay: 0.3 + i * 0.13, ease: [0.16, 1, 0.3, 1] });
    });
  }

  slide?.addEventListener("slide:enter", runSlide05Animations);
  if (slide?.closest("section.present") || slide?.classList.contains("present")) {
    runSlide05Animations();
  }
</script>
