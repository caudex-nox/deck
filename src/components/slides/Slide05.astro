---
---
<section>
  <div class="slide-content" style="background:#121212; width:100%; height:100%; overflow:hidden; font-family:'Inter',sans-serif;">
    <div style="position:relative; width:100%; height:100%; display:flex; align-items:center; justify-content:center;">

      <!-- Número decorativo de fondo -->
      <div style="position:absolute; right:-20px; top:50%; transform:translateY(-50%); font-size:320px; font-weight:900; color:rgba(255,247,205,0.02); line-height:1; letter-spacing:-0.05em; user-select:none;">2</div>

      <!-- Número de slide (superior derecho) -->
      <div style="position:absolute; top:28px; right:48px; font-size:11px; color:rgba(167,159,142,0.3); font-weight:600; letter-spacing:0.15em;">05 / 15</div>

      <div style="position:relative; z-index:10; max-width:960px; width:100%; padding:0 64px; display:grid; grid-template-columns:1fr 1fr; gap:56px; align-items:center;">

        <!-- Columna izquierda: texto -->
        <div>
          <p style="font-size:11px; color:#FFF7CD; letter-spacing:0.25em; text-transform:uppercase; font-weight:600; margin:0 0 16px 0;">Mercado Objetivo</p>
          <h2 style="font-size:44px; font-weight:800; color:#FFF7CD; margin:0 0 20px 0; line-height:1.1; letter-spacing:-0.02em;">Dos segmentos.<br/><span style="color:#FAF0B5;">Un foco.</span></h2>
          <p style="font-size:15px; color:#a79f8e; line-height:1.6; margin:0 0 32px 0;">Estrategia de segmentación diferenciada con productos específicos para cada nicho.</p>

          <!-- Stat grande -->
          <div style="padding:24px; background:rgba(255,247,205,0.05); border-left:3px solid #FFF7CD;">
            <div style="font-size:48px; font-weight:900; color:#FFF7CD; line-height:1; margin-bottom:8px;">167</div>
            <div style="font-size:13px; color:#FFF7CD; font-weight:500; margin-bottom:4px;">escuelas técnicas en Santa Fe</div>
            <div style="font-size:12px; color:#a79f8e;">Consumo aparente · INDEC + Ministerio de Educación</div>
          </div>
        </div>

        <!-- Columna derecha: segmentos -->
        <div style="display:flex; flex-direction:column; gap:16px;">
          <!-- Segmento 1 -->
          <div style="padding:24px; background:rgba(255,247,205,0.05); border:1px solid rgba(255,247,205,0.25);">
            <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:12px;">
              <div>
                <div style="font-size:11px; color:#FFF7CD; letter-spacing:0.15em; font-weight:600; margin-bottom:6px;">SEGMENTO A</div>
                <div style="font-size:18px; font-weight:700; color:#FFF7CD;">Instituciones Educativas</div>
              </div>
              <span style="padding:4px 10px; background:#FFF7CD; font-size:11px; color:#121212; font-weight:700;">KANON</span>
            </div>
            <p style="font-size:13px; color:#a79f8e; margin:0;">Secundarias técnicas, institutos ETP, centros de formación profesional.</p>
          </div>

          <!-- Segmento 2 -->
          <div style="padding:24px; background:rgba(255,255,255,0.03); border:1px solid rgba(255,247,205,0.15);">
            <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:12px;">
              <div>
                <div style="font-size:11px; color:#FAF0B5; letter-spacing:0.15em; font-weight:600; margin-bottom:6px;">SEGMENTO B</div>
                <div style="font-size:18px; font-weight:700; color:#FFF7CD;">PyMEs y Profesionales</div>
              </div>
              <span style="padding:4px 10px; background:rgba(255,247,205,0.1); border:1px solid rgba(255,247,205,0.3); font-size:11px; color:#FFF7CD; font-weight:700;">ORESTES</span>
            </div>
            <p style="font-size:13px; color:#a79f8e; margin:0;">Micro y pequeñas empresas que necesitan gestión de datos sin licencias en USD.</p>
          </div>

          <!-- Diferenciador -->
          <div style="padding:14px 18px; border-left:2px solid rgba(255,247,205,0.25); background:rgba(255,255,255,0.02);">
            <p style="font-size:13px; color:#a79f8e; margin:0; font-style:italic;">Precios en pesos · SaaS · Sin instalación local</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
