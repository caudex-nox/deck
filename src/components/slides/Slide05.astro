---
---
<!-- Slide 05 — Mercado Objetivo / Segmentos con contador animado -->
<section id="slide-05">
  <div class="slide-content" style="background:#121212; width:100%; height:100%; overflow:hidden; font-family:'Inter',sans-serif;">
    <div style="position:relative; width:100%; height:100%; display:flex; align-items:center; justify-content:center;">

      <div style="position:absolute; top:28px; right:48px; font-size:11px; color:rgba(167,159,142,0.3); font-weight:600; letter-spacing:0.15em;">09 / 20</div>

      <div style="position:relative; z-index:10; max-width:960px; width:100%; padding:0 64px; display:grid; grid-template-columns:1fr 1fr; gap:52px; align-items:center;">

        <!-- Columna izquierda -->
        <div>
          <p class="s05-label" style="font-size:11px; color:#FFF7CD; letter-spacing:0.25em; text-transform:uppercase; font-weight:600; margin:0 0 14px 0; opacity:0;">Mercado Objetivo</p>
          <h2 class="s05-title" style="font-size:44px; font-weight:800; color:#FFF7CD; margin:0 0 16px 0; line-height:1.1; letter-spacing:-0.02em; opacity:0;">Dos segmentos.<br/><span style="color:#FAF0B5;">Un foco.</span></h2>
          <p class="s05-sub" style="font-size:14px; color:#a79f8e; line-height:1.5; margin:0 0 24px 0; opacity:0;">Soluciones específicas adaptadas a la medida de cada nicho.</p>

          <!-- Stat grande con contador dinámico -->
          <div class="s05-stat" style="padding:22px; background:rgba(255,247,205,0.06); border-left:3px solid #FFF7CD; border-radius:2px; opacity:0;">
            <div class="s05-stat-num" data-target="167" style="font-size:52px; font-weight:900; color:#FFF7CD; line-height:1; margin-bottom:6px; font-family:'JetBrains Mono',monospace;">0</div>
            <div style="font-size:13px; color:#FFF7CD; font-weight:600; margin-bottom:2px;">escuelas técnicas en Santa Fe</div>
            <div style="font-size:11px; color:#a79f8e;">Consumo aparente · INDEC + Ministerio de Educación</div>
          </div>
        </div>

        <!-- Columna derecha: segmentos -->
        <div style="display:flex; flex-direction:column; gap:12px;">

          <div class="s05-seg" style="padding:20px 22px; background:rgba(255,247,205,0.05); border:1px solid rgba(255,247,205,0.25); border-radius:3px; opacity:0;">
            <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:8px;">
              <div>
                <div style="font-size:10px; color:#FFF7CD; letter-spacing:0.15em; font-weight:600; margin-bottom:3px;">SEGMENTO A</div>
                <div style="font-size:16px; font-weight:700; color:#FFF7CD;">Instituciones Educativas</div>
              </div>
              <span style="padding:3px 9px; background:#FFF7CD; font-size:10px; color:#121212; font-weight:800; border-radius:2px;">KANON</span>
            </div>
            <p style="font-size:12px; color:#a79f8e; margin:0; line-height:1.45;">Secundarias técnicas y centros ETP con necesidad de control de stock y activos.</p>
          </div>

          <div class="s05-seg" style="padding:20px 22px; background:rgba(255,255,255,0.03); border:1px solid rgba(255,247,205,0.18); border-radius:3px; opacity:0;">
            <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:8px;">
              <div>
                <div style="font-size:10px; color:#FAF0B5; letter-spacing:0.15em; font-weight:600; margin-bottom:3px;">SEGMENTO B</div>
                <div style="font-size:16px; font-weight:700; color:#FFF7CD;">PyMEs y Profesionales</div>
              </div>
              <span style="padding:3px 9px; background:rgba(255,247,205,0.12); border:1px solid rgba(255,247,205,0.3); font-size:10px; color:#FFF7CD; font-weight:700; border-radius:2px;">ORESTES</span>
            </div>
            <p style="font-size:12px; color:#a79f8e; margin:0; line-height:1.45;">Micro y pequeñas empresas que requieren gestión operativa sin licencias en USD.</p>
          </div>

          <div class="s05-seg" style="padding:10px 16px; border-left:2px solid rgba(255,247,205,0.3); background:rgba(255,255,255,0.02); border-radius:2px; opacity:0;">
            <p style="font-size:12px; color:#FFF7CD; margin:0; font-style:italic;">Precios en pesos · 100% SaaS · Sin instalación local</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .s05-seg {
    transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }
  .s05-seg:hover {
    transform: translateX(3px);
    border-color: rgba(255,247,205,0.45);
    background: rgba(255,247,205,0.08);
  }
</style>

<script>
  import { animate } from "motion";
  const slide = document.getElementById("slide-05");

  function countUp(el, target, duration = 850) {
    const startTime = performance.now();
    function step(currentTime) {
      const elapsed = currentTime - startTime;
      const progress = Math.min(elapsed / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      el.textContent = Math.round(target * eased).toString();
      if (progress < 1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }

  function runSlide05Animations() {
    if (!slide) return;

    const label = slide.querySelector(".s05-label");
    if (label) animate(label, { opacity: [0, 1], y: [-10, 0] }, { duration: 0.4, delay: 0.1 });

    const title = slide.querySelector(".s05-title");
    if (title) animate(title, { opacity: [0, 1], y: [-12, 0] }, { duration: 0.55, delay: 0.2, ease: [0.16, 1, 0.3, 1] });

    const sub = slide.querySelector(".s05-sub");
    if (sub) animate(sub, { opacity: [0, 1], y: [-8, 0] }, { duration: 0.4, delay: 0.25 });

    const stat = slide.querySelector(".s05-stat");
    if (stat) {
      animate(stat, { opacity: [0, 1], x: [-20, 0] }, { duration: 0.6, delay: 0.3, ease: [0.16, 1, 0.3, 1] })
        .then(() => {
          const numEl = stat.querySelector(".s05-stat-num");
          const target = parseInt(numEl?.getAttribute("data-target") || "0");
          if (numEl) countUp(numEl, target, 750);
        });
    }

    const segs = slide.querySelectorAll(".s05-seg");
    segs.forEach((s, i) => {
      animate(s, { opacity: [0, 1], x: [30, 0] }, { duration: 0.55, delay: 0.25 + i * 0.12, ease: [0.16, 1, 0.3, 1] });
    });
  }

  slide?.addEventListener("slide:enter", runSlide05Animations);
  if (slide?.closest("section.present") || slide?.classList.contains("present")) {
    runSlide05Animations();
  }
</script>
