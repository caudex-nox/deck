---
import { Target, Lightbulb, Globe, Users } from '@lucide/astro';
---
<section id="slide-03">
  <div class="slide-content" style="background:#121212; width:100%; height:100%; overflow:hidden; font-family:'Inter',sans-serif;">
    <div style="position:relative; width:100%; height:100%; display:flex; align-items:center; justify-content:center;">

      <!-- Círculos de luz -->
      <div style="position:absolute; top:-80px; right:-80px; width:450px; height:450px; border-radius:50%; background:radial-gradient(circle, rgba(255,247,205,0.06) 0%, transparent 70%);"></div>
      <div style="position:absolute; bottom:-120px; left:-40px; width:380px; height:380px; border-radius:50%; background:radial-gradient(circle, rgba(255,247,205,0.04) 0%, transparent 70%);"></div>

      <div style="position:absolute; top:28px; right:48px; font-size:11px; color:rgba(167,159,142,0.3); font-weight:600; letter-spacing:0.15em;">04 / 20</div>

      <div style="position:relative; z-index:10; max-width:960px; width:100%; padding:0 64px;">

        <p class="s03-label" style="font-size:11px; color:#FFF7CD; letter-spacing:0.25em; text-transform:uppercase; font-weight:600; margin:0 0 24px 0; opacity:0; text-align:center;">Identidad</p>

        <!-- Misión / Visión lado a lado con texto breve y centrado -->
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:28px;">

          <!-- Misión -->
          <div id="s03-mision" style="padding:32px 28px; background:rgba(255,247,205,0.05); border:1px solid rgba(255,247,205,0.25); text-align:center; border-radius:3px; opacity:0;">
            <div style="width:36px; height:3px; background:#FFF7CD; margin:0 auto 16px;"></div>
            <div style="font-size:22px; color:#FFF7CD; letter-spacing:0.15em; text-transform:uppercase; font-weight:700; margin-bottom:12px;">Misión</div>
            <p style="font-size:14px; color:#FFF7CD; line-height:1.5; margin:0 0 20px 0; font-weight:400;">
              Desarrollar soluciones de software innovadoras que resuelvan necesidades reales con alto valor técnico.
            </p>
            <!-- Iconos misión centrados -->
            <div style="display:flex; justify-content:center; gap:12px;">
              <div class="s03-icon-chip" title="Soluciones a medida"><Target size={18} stroke-width={1.8} /></div>
              <div class="s03-icon-chip" title="Tecnología de valor"><Lightbulb size={18} stroke-width={1.8} /></div>
            </div>
          </div>

          <!-- Visión -->
          <div id="s03-vision" style="padding:32px 28px; background:rgba(255,255,255,0.02); border:1px solid rgba(255,247,205,0.18); text-align:center; border-radius:3px; opacity:0;">
            <div style="width:36px; height:3px; background:rgba(255,247,205,0.4); margin:0 auto 16px;"></div>
            <div style="font-size:22px; color:#FAF0B5; letter-spacing:0.15em; text-transform:uppercase; font-weight:700; margin-bottom:12px;">Visión</div>
            <p style="font-size:14px; color:#a79f8e; line-height:1.5; margin:0 0 20px 0; font-weight:400;">
              Ser referentes del software argentino y aliados estratégicos en la digitalización de PyMEs e instituciones.
            </p>
            <!-- Iconos visión centrados -->
            <div style="display:flex; justify-content:center; gap:12px;">
              <div class="s03-icon-chip" title="Alcance nacional"><Globe size={18} stroke-width={1.8} /></div>
              <div class="s03-icon-chip" title="Alianzas estratégicas"><Users size={18} stroke-width={1.8} /></div>
            </div>
          </div>
        </div>

        <!-- Stack tecnológico centrado -->
        <div id="s03-stack" style="display:flex; align-items:center; justify-content:center; gap:10px; flex-wrap:wrap; opacity:0;">
          <span style="font-size:11px; color:rgba(167,159,142,0.4); letter-spacing:0.15em; text-transform:uppercase; margin-right:4px;">Stack:</span>
          {["React", "Node.js", "Astro", "PostgreSQL", "Prisma", "TypeScript", "C/C++"].map(tech => (
            <span style="padding:4px 10px; background:rgba(255,255,255,0.03); border:1px solid rgba(255,247,205,0.15); font-size:11px; color:#a79f8e; font-family:'JetBrains Mono', monospace; border-radius:2px;">{tech}</span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .s03-icon-chip {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 4px;
    background: rgba(255, 247, 205, 0.07);
    border: 1px solid rgba(255, 247, 205, 0.22);
    color: #FFF7CD;
    transition: transform 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
  }
  .s03-icon-chip:hover {
    transform: translateY(-2px);
    background: rgba(255, 247, 205, 0.16);
    box-shadow: 0 4px 12px rgba(255, 247, 205, 0.18);
  }
</style>

<script>
  import { animate } from "motion";

  const slide = document.getElementById("slide-03");

  function runSlide03Animations() {
    if (!slide) return;

    // Label
    const label = slide.querySelector(".s03-label");
    if (label) animate(label, { opacity: [0, 1], y: [-8, 0] }, { duration: 0.4, ease: "easeOut" });

    // Misión — entra desde la izquierda
    const mision = slide.querySelector("#s03-mision");
    if (mision) animate(mision, { opacity: [0, 1], x: [-35, 0] }, { duration: 0.65, delay: 0.15, ease: [0.16, 1, 0.3, 1] });

    // Visión — entra desde la derecha
    const vision = slide.querySelector("#s03-vision");
    if (vision) animate(vision, { opacity: [0, 1], x: [35, 0] }, { duration: 0.65, delay: 0.25, ease: [0.16, 1, 0.3, 1] });

    // Stack — fade desde abajo
    const stack = slide.querySelector("#s03-stack");
    if (stack) animate(stack, { opacity: [0, 1], y: [12, 0] }, { duration: 0.5, delay: 0.5, ease: "easeOut" });

    // Iconos — bounce-in escalonado centrado
    const chips = slide.querySelectorAll(".s03-icon-chip");
    chips.forEach((chip, i) => {
      animate(
        chip,
        { scale: [0, 1.15, 1], opacity: [0, 1] },
        { duration: 0.4, delay: 0.6 + i * 0.08, ease: [0.34, 1.56, 0.64, 1] }
      );
    });
  }

  slide?.addEventListener("slide:enter", runSlide03Animations);
  if (slide?.closest("section.present") || slide?.classList.contains("present")) {
    runSlide03Animations();
  }
</script>
