---
---
<!-- Slide 08 — Estrategia Comercial (Abell + 4P) — con animaciones -->
<section id="slide-08">
  <div class="slide-content" style="background:#121212; width:100%; height:100%; overflow:hidden; font-family:'Inter',sans-serif;">
    <div style="position:relative; width:100%; height:100%; display:flex; align-items:center; justify-content:center;">

      <div style="position:absolute; top:28px; right:48px; font-size:11px; color:rgba(167,159,142,0.3); font-weight:600; letter-spacing:0.15em;">12 / 21</div>

      <div style="position:relative; z-index:10; max-width:960px; width:100%; padding:0 64px; display:grid; grid-template-columns:0.95fr 1.05fr; gap:36px; align-items:start;">

        <!-- Izquierda: Modelo Abell -->
        <div id="s08-abell" style="padding:22px 20px 18px; background:rgba(255,247,205,0.04); border:1px solid rgba(255,247,205,0.2); opacity:0;">
          <p style="font-size:11px; color:#FFF7CD; letter-spacing:0.25em; text-transform:uppercase; font-weight:600; margin:0 0 14px 0;">Modelo Abell</p>
          <h2 style="font-size:30px; font-weight:800; color:#FFF7CD; margin:0 0 8px 0; line-height:1.1; letter-spacing:-0.02em;">Cómo nos <span style="color:#FAF0B5;">posicionamos</span></h2>

          <img class="s08-abell-diagram" src="/images/abell.svg" alt="Diagrama de Abell: funciones, grupos de compradores y tecnologías" />
          <div class="s08-abell-legend">
            <span><b>Qué</b> resuelve</span><span><b>A quién</b> sirve</span><span><b>Cómo</b> lo hace</span>
          </div>
        </div>

        <!-- Derecha: 4P -->
        <div>
          <p class="s08-4p-label" style="font-size:11px; color:#FFF7CD; letter-spacing:0.2em; text-transform:uppercase; font-weight:600; margin:0 0 14px 0; opacity:0;">Marketing Mix · Las 4P</p>
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">

            <div class="s08-p-card" style="padding:16px; background:rgba(255,255,255,0.03); border:1px solid rgba(255,247,205,0.15); opacity:0;">
              <div style="font-size:24px; font-weight:900; color:rgba(255,247,205,0.35); line-height:1; margin-bottom:8px;">P1</div>
              <div style="font-size:15px; font-weight:700; color:#FFF7CD; margin-bottom:4px;">Producto</div>
              <div style="font-size:13px; color:#a79f8e; line-height:1.5;">SaaS modular</div>
            </div>

            <div class="s08-p-card" style="padding:16px; background:rgba(255,247,205,0.05); border:1px solid rgba(255,247,205,0.25); opacity:0;">
              <div style="font-size:24px; font-weight:900; color:#FFF7CD; line-height:1; margin-bottom:8px;">P2</div>
              <div style="font-size:15px; font-weight:700; color:#FFF7CD; margin-bottom:4px;">Precio</div>
              <div style="font-size:13px; color:#a79f8e; line-height:1.5;">Pesos · competitivo</div>
            </div>

            <div class="s08-p-card" style="padding:16px; background:rgba(255,255,255,0.02); border:1px solid rgba(255,247,205,0.12); opacity:0;">
              <div style="font-size:24px; font-weight:900; color:rgba(255,247,205,0.3); line-height:1; margin-bottom:8px;">P3</div>
              <div style="font-size:15px; font-weight:700; color:#FFF7CD; margin-bottom:4px;">Plaza</div>
              <div style="font-size:13px; color:#a79f8e; line-height:1.5;">Digital · cloud</div>
            </div>

            <div class="s08-p-card" style="padding:16px; background:rgba(255,255,255,0.02); border:1px solid rgba(255,247,205,0.08); opacity:0;">
              <div style="font-size:24px; font-weight:900; color:rgba(255,247,205,0.22); line-height:1; margin-bottom:8px;">P4</div>
              <div style="font-size:15px; font-weight:700; color:#FFF7CD; margin-bottom:4px;">Promoción</div>
              <div style="font-size:13px; color:#a79f8e; line-height:1.5;">Demo · piloto 30 días</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .s08-abell-diagram {
    display: block;
    width: 100%;
    height: 224px;
    margin: 2px 0 0;
    overflow: visible;
  }
  .s08-abell-diagram {
    display: block;
    width: 100%;
    height: 224px;
    object-fit: contain;
    object-position: center;
    margin: 2px 0 0;
  }
  .s08-abell-legend {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    margin-top: 10px;
    color: #a79f8e;
    font-size: 10px;
  }
  .s08-abell-legend b {
    color: #FFF7CD;
    font-weight: 700;
  }
</style>

<script>
  import { animate } from "motion";
  const slide = document.getElementById("slide-08");

  function runSlide08Animations() {
    if (!slide) return;

    // Bloque Abell entra desde la izquierda
    const abell = slide.querySelector("#s08-abell");
    if (abell) animate(abell, { opacity: [0, 1], x: [-30, 0] }, { duration: 0.65, delay: 0.1, ease: [0.16, 1, 0.3, 1] });

    const label4p = slide.querySelector(".s08-4p-label");
    if (label4p) animate(label4p, { opacity: [0, 1], y: [-8, 0] }, { duration: 0.4, delay: 0.15 });

    // Tarjetas 4P: diagonal izq-der, arr-abajo
    const pCards = slide.querySelectorAll(".s08-p-card");
    const offsets = [[20, -10], [-20, -10], [20, 10], [-20, 10]];
    pCards.forEach((card, i) => {
      animate(
        card,
        { opacity: [0, 1], x: [offsets[i][0], 0], y: [offsets[i][1], 0] },
        { duration: 0.5, delay: 0.3 + i * 0.1, ease: [0.16, 1, 0.3, 1] }
      );
    });

    pCards.forEach((card, i) => {
      animate(card, { borderColor: ["rgba(255,247,205,0.15)", "rgba(255,247,205,0.38)", "rgba(255,247,205,0.15)"] }, { duration: 3.2, delay: 1.1 + i * 0.25, repeat: Infinity, ease: "easeInOut" });
    });

    // Pequeños roces entre las tarjetas: se acercan y vuelven a su sitio.
    pCards.forEach((card, i) => {
      const direction = i % 2 === 0 ? 1 : -1;
      animate(
        card,
        { x: [0, direction * 4, direction * -2, 0], rotate: [0, direction * 0.25, direction * -0.12, 0] },
        { duration: 1.1, delay: 4.5 + i * 1.15, repeat: Infinity, repeatDelay: 8.5, ease: [0.22, 1, 0.36, 1] }
      );
    });
  }

  slide?.addEventListener("slide:enter", runSlide08Animations);
  if (slide?.closest("section.present") || slide?.classList.contains("present")) {
    runSlide08Animations();
  }
</script>
