---
<section>
  <div class="slide-content" style="background:#121212; width:100%; height:100%; overflow:hidden; font-family:'Inter',sans-serif;">
    <div style="position:relative; width:100%; height:100%; display:flex; align-items:center; justify-content:center;">

      <!-- Número de slide (superior derecho) -->
      <div style="position:absolute; top:28px; right:48px; font-size:11px; color:rgba(167,159,142,0.3); font-weight:600; letter-spacing:0.15em;">08 / 15</div>

      <div style="position:relative; z-index:10; max-width:960px; width:100%; padding:0 64px; display:grid; grid-template-columns:0.95fr 1.05fr; gap:36px; align-items:start;">

        <!-- Izquierda: Modelo Abell — contenedor con su propio borde y fondo sin superposiciones -->
        <div style="padding:28px; background:rgba(255,247,205,0.04); border:1px solid rgba(255,247,205,0.2);">
          <p style="font-size:11px; color:#FFF7CD; letter-spacing:0.25em; text-transform:uppercase; font-weight:600; margin:0 0 16px 0;">Estrategia Comercial · Modelo Abell</p>
          <h2 style="font-size:36px; font-weight:800; color:#FFF7CD; margin:0 0 24px 0; line-height:1.1; letter-spacing:-0.02em;">Cómo nos<br/><span style="color:#FAF0B5;">posicionamos</span></h2>

          <div style="display:flex; flex-direction:column; gap:12px;">
            <div style="padding:14px 16px; border-left:3px solid #FFF7CD; background:rgba(255,247,205,0.06);">
              <div style="font-size:11px; color:#FFF7CD; letter-spacing:0.15em; font-weight:600; margin-bottom:6px;">¿A QUIÉN?</div>
              <div style="font-size:14px; color:#a79f8e; line-height:1.5;">Instituciones educativas · PyMEs argentinas</div>
            </div>
            <div style="padding:14px 16px; border-left:3px solid rgba(255,247,205,0.5); background:rgba(255,255,255,0.03);">
              <div style="font-size:11px; color:#FAF0B5; letter-spacing:0.15em; font-weight:600; margin-bottom:6px;">¿QUÉ?</div>
              <div style="font-size:14px; color:#a79f8e; line-height:1.5;">Digitalización, trazabilidad y gestión de datos</div>
            </div>
            <div style="padding:14px 16px; border-left:3px solid rgba(255,247,205,0.25); background:rgba(255,255,255,0.02);">
              <div style="font-size:11px; color:rgba(255,247,205,0.7); letter-spacing:0.15em; font-weight:600; margin-bottom:6px;">¿CÓMO?</div>
              <div style="font-size:14px; color:#a79f8e; line-height:1.5;">Arquitecturas modernas sin licencias extranjeras, metodologías ágiles</div>
            </div>
          </div>
        </div>

        <!-- Derecha: 4P -->
        <div>
          <p style="font-size:11px; color:#FFF7CD; letter-spacing:0.2em; text-transform:uppercase; font-weight:600; margin:0 0 16px 0;">Las 4P</p>
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">

            <div style="padding:18px; background:rgba(255,255,255,0.03); border:1px solid rgba(255,247,205,0.15);">
              <div style="font-size:28px; font-weight:900; color:rgba(255,247,205,0.4); line-height:1; margin-bottom:10px;">P1</div>
              <div style="font-size:14px; font-weight:700; color:#FFF7CD; margin-bottom:6px;">Producto</div>
              <div style="font-size:12px; color:#a79f8e; line-height:1.5;">Soluciones modulares y escalables</div>
            </div>

            <div style="padding:18px; background:rgba(255,247,205,0.05); border:1px solid rgba(255,247,205,0.25);">
              <div style="font-size:28px; font-weight:900; color:#FFF7CD; line-height:1; margin-bottom:10px;">P2</div>
              <div style="font-size:14px; font-weight:700; color:#FFF7CD; margin-bottom:6px;">Precio</div>
              <div style="font-size:12px; color:#a79f8e; line-height:1.5;">Costo + margen · En pesos · Competitivo</div>
            </div>

            <div style="padding:18px; background:rgba(255,255,255,0.02); border:1px solid rgba(255,247,205,0.12);">
              <div style="font-size:28px; font-weight:900; color:rgba(255,247,205,0.35); line-height:1; margin-bottom:10px;">P3</div>
              <div style="font-size:14px; font-weight:700; color:#FFF7CD; margin-bottom:6px;">Plaza</div>
              <div style="font-size:12px; color:#a79f8e; line-height:1.5;">100% digital · SaaS · Vercel + Render</div>
            </div>

            <div style="padding:18px; background:rgba(255,255,255,0.02); border:1px solid rgba(255,247,205,0.08);">
              <div style="font-size:28px; font-weight:900; color:rgba(255,247,205,0.25); line-height:1; margin-bottom:10px;">P4</div>
              <div style="font-size:14px; font-weight:700; color:#FFF7CD; margin-bottom:6px;">Promoción</div>
              <div style="font-size:12px; color:#a79f8e; line-height:1.5;">Visita directa · LinkedIn · Instagram</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
