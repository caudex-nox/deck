<!-- Separador Capítulo 2 — Diagnóstico de Entorno -->
<section id="slide-chap2">
  <div class="slide-content" style="background:#121212; width:100%; height:100%; overflow:hidden; font-family:'Inter',sans-serif;">
    <div style="position:relative; width:100%; height:100%; display:flex; align-items:center; justify-content:center;">

      <div id="chap2-bg-num" style="position:absolute; right:-40px; top:50%; transform:translateY(-50%); font-size:380px; font-weight:900; color:rgba(255,247,205,0); line-height:1; user-select:none; letter-spacing:-0.05em;">2</div>

      <div id="chap2-line" style="position:absolute; left:0; top:0; width:4px; height:100%; background:linear-gradient(to bottom, transparent, #FFF7CD, transparent); opacity:0;"></div>

      <div id="chap2-label" style="position:absolute; top:28px; left:64px; font-size:11px; color:rgba(255,247,205,0.25); font-weight:600; letter-spacing:0.25em; text-transform:uppercase; opacity:0;">Sección 02</div>
      <div style="position:absolute; top:28px; right:48px; font-size:11px; color:rgba(167,159,142,0.3); font-weight:600; letter-spacing:0.15em;">06 / 21</div>

      <div style="position:relative; z-index:10; padding:0 64px; max-width:700px; width:100%;">
        <div id="chap2-tag" style="display:inline-block; padding:6px 14px; border:1px solid rgba(255,247,205,0.3); background:rgba(255,247,205,0.05); margin-bottom:24px; opacity:0;">
          <span style="font-size:11px; color:#FFF7CD; font-weight:600; letter-spacing:0.2em;">CAPÍTULO 2</span>
        </div>
        <h1 id="chap2-title" style="font-size:56px; font-weight:900; color:#FFF7CD; line-height:1.05; letter-spacing:-0.03em; margin:0; opacity:0;">
          Diagnóstico<br/>del <span style="color:#FAF0B5;">Entorno</span>
        </h1>
      </div>
    </div>
  </div>
</section>

<script>
  import { animate } from "motion";

  const slide = document.getElementById("slide-chap2");
  let pulseAnim = null;

  function runChap2Animations() {
    if (!slide) return;

    const line = slide.querySelector("#chap2-line");
    if (line) animate(line, { scaleY: [0, 1], opacity: [0, 1] }, { duration: 0.9, ease: [0.16, 1, 0.3, 1] });

    const label = slide.querySelector("#chap2-label");
    if (label) animate(label, { opacity: [0, 0.25] }, { duration: 0.4, delay: 0.2 });

    const tag = slide.querySelector("#chap2-tag");
    if (tag) animate(tag, { opacity: [0, 1], y: [10, 0] }, { duration: 0.4, delay: 0.25 });

    const title = slide.querySelector("#chap2-title");
    if (title) animate(title, { opacity: [0, 1], y: [30, 0] }, { duration: 0.7, delay: 0.35, ease: [0.16, 1, 0.3, 1] });

    const bgNum = slide.querySelector("#chap2-bg-num");
    if (bgNum) {
      animate(bgNum, { color: ["rgba(255,247,205,0)", "rgba(255,247,205,0.025)"] }, { duration: 1, delay: 0.3 })
        .then(() => {
          pulseAnim = animate(
            bgNum,
            { color: ["rgba(255,247,205,0.015)", "rgba(255,247,205,0.04)", "rgba(255,247,205,0.015)"] },
            { duration: 3.5, repeat: Infinity, ease: "easeInOut" }
          );
        });
    }
  }

  function stopChap2Animations() {
    if (pulseAnim) { pulseAnim.stop(); pulseAnim = null; }
  }

  slide?.addEventListener("slide:enter", runChap2Animations);
  slide?.addEventListener("slide:leave", stopChap2Animations);
  if (slide?.closest("section.present") || slide?.classList.contains("present")) {
    runChap2Animations();
  }
</script>
