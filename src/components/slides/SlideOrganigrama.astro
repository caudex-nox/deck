---
<!-- Organigrama — Capítulo 4 -->
<section id="slide-org">
  <div class="slide-content" style="background:#121212; width:100%; height:100%; overflow:hidden; font-family:'Inter',sans-serif;">
    <div style="position:relative; width:100%; height:100%; display:flex; align-items:center; justify-content:center;">

      <div style="position:absolute; right:0; top:0; width:4px; height:100%; background:linear-gradient(to bottom, transparent, #FFF7CD, transparent);"></div>
      <div style="position:absolute; top:28px; right:48px; font-size:11px; color:rgba(167,159,142,0.3); font-weight:600; letter-spacing:0.15em;">18 / 21</div>

      <div style="position:relative; z-index:10; max-width:960px; width:100%; padding:0 64px;">

        <p class="sorg-label" style="font-size:11px; color:#FFF7CD; letter-spacing:0.25em; text-transform:uppercase; font-weight:600; margin:0 0 14px 0; opacity:0;">Recursos Humanos · Estructura</p>
        <h2 class="sorg-title" style="font-size:42px; font-weight:800; color:#FFF7CD; margin:0 0 28px 0; letter-spacing:-0.02em; opacity:0;">Organigrama <span style="color:#FAF0B5;">funcional</span></h2>

        <div class="sorg-structure">
        <!-- Nodo raíz -->
        <div style="display:flex; flex-direction:column; align-items:center;">
          <div class="sorg-node sorg-root" style="opacity:0; padding:12px 28px; background:rgba(255,247,205,0.1); border:1px solid rgba(255,247,205,0.45); text-align:center;">
            <div style="font-size:12px; color:rgba(255,247,205,0.5); letter-spacing:0.15em; margin-bottom:4px;">DIRECCIÓN GENERAL</div>
            <div style="font-size:17px; font-weight:700; color:#FFF7CD;">Mesa Co-Fundadora</div>
          </div>

          <!-- Siete áreas funcionales, resumidas por su función principal -->
          <div class="sorg-departments" style="display:grid; grid-template-columns:repeat(12, 1fr); column-gap:10px; row-gap:22px; width:100%;">
            <div class="sorg-node sorg-branch sorg-top" style="opacity:0; padding:12px 10px; background:rgba(74,144,217,0.08); border:1px solid rgba(74,144,217,0.25); text-align:center;">
              <div class="sorg-dept">INGENIERÍA</div><div class="sorg-role">Desarrollo y QA</div>
            </div>
            <div class="sorg-node sorg-branch sorg-top" style="opacity:0; padding:12px 10px; background:rgba(255,247,205,0.07); border:1px solid rgba(255,247,205,0.2); text-align:center;">
              <div class="sorg-dept">PRODUCTO · PMO</div><div class="sorg-role">Visión y proyectos</div>
            </div>
            <div class="sorg-node sorg-branch sorg-top" style="opacity:0; padding:12px 10px; background:rgba(255,255,255,0.035); border:1px solid rgba(255,247,205,0.16); text-align:center;">
              <div class="sorg-dept">DEVOPS</div><div class="sorg-role">Cloud y seguridad</div>
            </div>
            <div class="sorg-node sorg-branch sorg-top" style="opacity:0; padding:12px 10px; background:rgba(255,200,100,0.06); border:1px solid rgba(255,200,100,0.18); text-align:center;">
              <div class="sorg-dept">VENTAS</div><div class="sorg-role">Clientes B2B</div>
            </div>
            <div class="sorg-node sorg-branch sorg-bottom" style="opacity:0; padding:12px 10px; background:rgba(255,255,255,0.03); border:1px solid rgba(255,247,205,0.14); text-align:center;">
              <div class="sorg-dept">MARKETING</div><div class="sorg-role">Marca y comunidad</div>
            </div>
            <div class="sorg-node sorg-branch sorg-bottom" style="opacity:0; padding:12px 10px; background:rgba(255,255,255,0.025); border:1px solid rgba(255,247,205,0.12); text-align:center;">
              <div class="sorg-dept">ADMINISTRACIÓN</div><div class="sorg-role">Finanzas y legal</div>
            </div>
            <div class="sorg-node sorg-branch sorg-bottom" style="opacity:0; padding:12px 10px; background:rgba(255,255,255,0.02); border:1px solid rgba(255,247,205,0.1); text-align:center;">
              <div class="sorg-dept">RR. HH.</div><div class="sorg-role">Talento y cultura</div>
            </div>
          </div>

          <svg class="sorg-connections" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            <path class="sorg-dotted" d="M50 20 V36" />
            <path class="sorg-dotted" d="M12.5 36 H87.5" />
            <path class="sorg-dotted" d="M12.5 36 V45 M37.5 36 V45 M62.5 36 V45 M87.5 36 V45" />
            <path class="sorg-dotted" d="M50 58 V68" />
            <path class="sorg-dotted" d="M25 68 H75" />
            <path class="sorg-dotted" d="M25 68 V76 M50 68 V76 M75 68 V76" />
          </svg>
          </div>
        </div>

        <!-- Nota legal -->
        <div class="sorg-note" style="margin-top:20px; padding:10px 16px; border-left:2px solid rgba(255,247,205,0.2); opacity:0;">
          <span style="font-size:13px; color:#a79f8e;">Convenio IT · remoto/híbrido · talento local</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .sorg-node {
    border-radius: 3px;
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .sorg-node:hover {
    border-color: rgba(255,247,205,0.5) !important;
    background: rgba(255,247,205,0.1) !important;
  }
  .sorg-departments {
    position: relative;
    grid-template-columns: repeat(12, 1fr) !important;
    column-gap: 10px !important;
    row-gap: 22px !important;
    margin-top: 32px;
  }
  .sorg-structure {
    position: relative;
    width: 100%;
  }
  .sorg-connections {
    position: absolute;
    z-index: 0;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .sorg-dotted {
    fill: none;
    stroke: rgba(255,247,205,0.48);
    stroke-width: 0.45;
    stroke-linecap: round;
    stroke-dasharray: 0.8 2.2;
    stroke-dashoffset: 0;
    vector-effect: non-scaling-stroke;
    filter: drop-shadow(0 0 2px rgba(255,247,205,0.35));
    animation: sorg-dots-flow 2.8s linear infinite;
  }
  .sorg-dotted:nth-child(2) { animation-delay: 0.18s; }
  .sorg-dotted:nth-child(3) { animation-delay: 0.36s; }
  .sorg-dotted:nth-child(4) { animation-delay: 0.54s; }
  .sorg-dotted:nth-child(5) { animation-delay: 0.72s; }
  .sorg-dotted:nth-child(6) { animation-delay: 0.9s; }
  @keyframes sorg-dots-flow {
    from { stroke-dashoffset: 0; opacity: 0.35; }
    45% { opacity: 0.85; }
    to { stroke-dashoffset: -6; opacity: 0.35; }
  }
  .sorg-branch {
    position: relative;
    z-index: 1;
  }
  .sorg-top:nth-child(1) { grid-column: 1 / span 3; }
  .sorg-top:nth-child(2) { grid-column: 4 / span 3; }
  .sorg-top:nth-child(3) { grid-column: 7 / span 3; }
  .sorg-top:nth-child(4) { grid-column: 10 / span 3; }
  .sorg-bottom:nth-child(5) { grid-column: 2 / span 3; }
  .sorg-bottom:nth-child(6) { grid-column: 5 / span 3; }
  .sorg-bottom:nth-child(7) { grid-column: 8 / span 3; }
  .sorg-dept {
    font-size:10px;
    color:#FFF7CD;
    letter-spacing:0.1em;
    font-weight:700;
    margin-bottom:5px;
  }
  .sorg-role {
    font-size:13px;
    color:#a79f8e;
    line-height:1.25;
  }
</style>

<script>
  import { animate } from "motion";

  const slide = document.getElementById("slide-org");

  function runSlideOrgAnimations() {
    if (!slide) return;

    const label = slide.querySelector(".sorg-label");
    if (label) animate(label, { opacity: [0, 1], y: [-6, 0] }, { duration: 0.4 });

    const title = slide.querySelector(".sorg-title");
    if (title) animate(title, { opacity: [0, 1], y: [-8, 0] }, { duration: 0.5, delay: 0.1 });

    // Nodo raíz
    const root = slide.querySelector(".sorg-root");
    if (root) animate(root, { opacity: [0, 1], scale: [0.95, 1] }, { duration: 0.5, delay: 0.2, ease: [0.16, 1, 0.3, 1] });

    // Las siete áreas aparecen en una onda horizontal.
    const branches = slide.querySelectorAll(".sorg-branch");
    branches.forEach((b, i) => {
      animate(
        b,
        { opacity: [0, 1], y: [16, 0], scale: [0.96, 1] },
        { duration: 0.5, delay: 0.4 + i * 0.08, ease: [0.16, 1, 0.3, 1] }
      );
    });

    const note = slide.querySelector(".sorg-note");
    if (note) animate(note, { opacity: [0, 1] }, { duration: 0.5, delay: 1.0 });

    branches.forEach((branch, i) => {
      animate(branch, { boxShadow: ["0 0 0 rgba(255,247,205,0)", "0 0 14px rgba(255,247,205,0.2)", "0 0 0 rgba(255,247,205,0)"] }, { duration: 3.2, delay: 1.2 + i * 0.3, repeat: Infinity, ease: "easeInOut" });
    });
  }

  slide?.addEventListener("slide:enter", runSlideOrgAnimations);
  if (slide?.closest("section.present") || slide?.classList.contains("present")) {
    runSlideOrgAnimations();
  }
</script>
