---
---
<section id="slide-04">
  <div class="slide-content" style="background:#121212; width:100%; height:100%; overflow:hidden; font-family:'Inter',sans-serif;">
    <div style="position:relative; width:100%; height:100%; display:flex; align-items:center; justify-content:center;">

      <div style="position:absolute; left:0; top:0; width:50%; height:100%; background:linear-gradient(to right, rgba(255,247,205,0.02) 0%, transparent 100%);"></div>
      <div style="position:absolute; top:28px; right:48px; font-size:11px; color:rgba(167,159,142,0.3); font-weight:600; letter-spacing:0.15em;">05 / 20</div>

      <div style="position:relative; z-index:10; max-width:960px; width:100%; padding:0 64px;">

        <p class="s04-label" style="font-size:11px; color:#FFF7CD; letter-spacing:0.25em; text-transform:uppercase; font-weight:600; margin:0 0 14px 0; opacity:0;">Nuestros Productos</p>
        <h2 class="s04-title" style="font-size:42px; font-weight:800; color:#FFF7CD; margin:0 0 32px 0; letter-spacing:-0.02em; opacity:0;">Tres soluciones.<br/><span style="color:#FAF0B5;">Un ecosistema.</span></h2>

        <!-- 3 productos: Kanon | Orestes | Deck con fondos oscuros neutros que destacan los logos -->
        <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:16px;">

          <!-- Kanon (Logo celeste/azul sobre fondo oscuro puro) -->
          <div class="s04-card" style="padding:28px 24px; background:#161618; border:1px solid rgba(255,247,205,0.18); position:relative; overflow:hidden; border-radius:3px; opacity:0;">
            <div style="position:absolute; top:0; left:0; right:0; height:2px; background:linear-gradient(to right, #FFF7CD, #FAF0B5);"></div>
            <div style="display:flex; align-items:center; justify-content:center; height:56px; margin-bottom:16px; background:rgba(255,255,255,0.02); border-radius:4px; padding:6px;">
              <img src="/images/kanon.png" alt="Kanon" style="height:42px; width:auto; object-fit:contain;" />
            </div>
            <p style="font-size:13px; color:#a79f8e; line-height:1.45; margin:0 0 16px 0;">Control de stock y activos para instituciones educativas.</p>
            <div style="padding:5px 10px; background:rgba(255,247,205,0.06); display:inline-block; border:1px solid rgba(255,247,205,0.2); border-radius:2px;">
              <span style="font-size:11px; color:#FFF7CD; font-weight:600;">Colegios · ETP · Stock</span>
            </div>
          </div>

          <!-- Orestes (Logo blanco sobre fondo grafito oscuro) -->
          <div class="s04-card" style="padding:28px 24px; background:#18181a; border:1px solid rgba(255,247,205,0.25); position:relative; overflow:hidden; border-radius:3px; opacity:0;">
            <div style="position:absolute; top:0; left:0; right:0; height:2px; background:linear-gradient(to right, #FAF0B5, #FFF7CD);"></div>
            <div style="display:flex; align-items:center; justify-content:center; height:56px; margin-bottom:16px; background:rgba(255,255,255,0.02); border-radius:4px; padding:6px;">
              <img src="/images/orestes.svg" alt="Orestes" style="height:38px; width:auto; object-fit:contain;" />
            </div>
            <p style="font-size:13px; color:#a79f8e; line-height:1.45; margin:0 0 16px 0;">Gestión de datos y procesos operativos para PyMEs.</p>
            <div style="padding:5px 10px; background:rgba(255,247,205,0.06); display:inline-block; border:1px solid rgba(255,247,205,0.2); border-radius:2px;">
              <span style="font-size:11px; color:#FFF7CD; font-weight:600;">React · PostgreSQL</span>
            </div>
          </div>

          <!-- Deck (Logo azul+dorado sobre fondo carbón pulido) -->
          <div class="s04-card" style="padding:28px 24px; background:#151517; border:1px solid rgba(255,247,205,0.18); position:relative; overflow:hidden; border-radius:3px; opacity:0;">
            <div style="position:absolute; top:0; left:0; right:0; height:2px; background:linear-gradient(to right, #FFF7CD, #FAF0B5);"></div>
            <div style="display:flex; align-items:center; justify-content:center; height:56px; margin-bottom:16px; background:rgba(255,255,255,0.02); border-radius:4px; padding:6px;">
              <img src="/images/deck.svg" alt="Deck" style="height:38px; width:auto; object-fit:contain;" />
            </div>
            <p style="font-size:13px; color:#a79f8e; line-height:1.45; margin:0 0 16px 0;">Presentaciones técnicas dinámicas y modulares.</p>
            <div style="padding:5px 10px; background:rgba(255,247,205,0.06); display:inline-block; border:1px solid rgba(255,247,205,0.2); border-radius:2px;">
              <span style="font-size:11px; color:#FFF7CD; font-weight:600;">Astro · Reveal.js</span>
            </div>
          </div>
        </div>

        <p class="s04-footer" style="margin-top:24px; font-size:12px; color:rgba(167,159,142,0.45); font-style:italic; opacity:0; text-align:center;">Software local, modular y sin licencias en moneda extranjera</p>
      </div>
    </div>
  </div>
</section>

<style>
  .s04-card {
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .s04-card:hover {
    transform: translateY(-4px);
    border-color: rgba(255,247,205,0.55) !important;
    box-shadow: 0 10px 28px rgba(0,0,0,0.5);
  }
</style>

<script>
  import { animate } from "motion";

  const slide = document.getElementById("slide-04");

  function runSlide04Animations() {
    if (!slide) return;

    const label = slide.querySelector(".s04-label");
    if (label) animate(label, { opacity: [0, 1], y: [-8, 0] }, { duration: 0.4 });

    const title = slide.querySelector(".s04-title");
    if (title) animate(title, { opacity: [0, 1], y: [-10, 0] }, { duration: 0.5, delay: 0.1, ease: [0.16, 1, 0.3, 1] });

    // Tarjetas entran con zoom sutil escalonado
    const cards = slide.querySelectorAll(".s04-card");
    cards.forEach((card, i) => {
      animate(
        card,
        { opacity: [0, 1], scale: [0.92, 1], y: [18, 0] },
        { duration: 0.6, delay: 0.2 + i * 0.14, ease: [0.16, 1, 0.3, 1] }
      );
    });

    const footer = slide.querySelector(".s04-footer");
    if (footer) animate(footer, { opacity: [0, 0.6] }, { duration: 0.5, delay: 0.75 });
  }

  slide?.addEventListener("slide:enter", runSlide04Animations);
  if (slide?.closest("section.present") || slide?.classList.contains("present")) {
    runSlide04Animations();
  }
</script>
