---
---
<section>
  <div class="slide-content" style="background:#121212; width:100%; height:100%; overflow:hidden; font-family:'Inter',sans-serif;">
    <div style="position:relative; width:100%; height:100%; display:flex; align-items:center; justify-content:center;">

      <div style="position:absolute; left:0; top:0; width:50%; height:100%; background:linear-gradient(to right, rgba(255,247,205,0.03) 0%, transparent 100%);"></div>

      <!-- Número de slide (superior derecho) -->
      <div style="position:absolute; top:28px; right:48px; font-size:11px; color:rgba(167,159,142,0.3); font-weight:600; letter-spacing:0.15em;">04 / 15</div>

      <div style="position:relative; z-index:10; max-width:960px; width:100%; padding:0 64px;">

        <p style="font-size:11px; color:#FFF7CD; letter-spacing:0.25em; text-transform:uppercase; font-weight:600; margin:0 0 16px 0;">Nuestros Productos</p>
        <h2 style="font-size:42px; font-weight:800; color:#FFF7CD; margin:0 0 36px 0; letter-spacing:-0.02em;">Tres soluciones.<br/><span style="color:#FAF0B5;">Un ecosistema.</span></h2>

        <!-- 3 productos en fila -->
        <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:16px;">

          <!-- Kanon -->
          <div style="padding:28px 24px; background:rgba(255,247,205,0.05); border:1px solid rgba(255,247,205,0.3); position:relative; overflow:hidden;">
            <div style="position:absolute; top:0; left:0; right:0; height:2px; background:linear-gradient(to right, #FFF7CD, #FAF0B5);"></div>
            <div style="font-size:13px; font-family:'JetBrains Mono',monospace; color:#FFF7CD; letter-spacing:0.1em; margin-bottom:12px;">kanon.app</div>
            <h3 style="font-size:24px; font-weight:800; color:#FFF7CD; margin:0 0 10px 0;">Kanon</h3>
            <p style="font-size:13px; color:#a79f8e; line-height:1.55; margin:0 0 16px 0;">Control de inventario y activos para instituciones educativas</p>
            <div style="padding:6px 10px; background:rgba(255,247,205,0.08); display:inline-block; border:1px solid rgba(255,247,205,0.15);">
              <span style="font-size:11px; color:#FFF7CD; font-weight:600;">Colegios · ETP · Stock</span>
            </div>
          </div>

          <!-- Orestes -->
          <div style="padding:28px 24px; background:rgba(255,255,255,0.03); border:1px solid rgba(255,247,205,0.15); position:relative; overflow:hidden;">
            <div style="position:absolute; top:0; left:0; right:0; height:2px; background:rgba(255,247,205,0.3);"></div>
            <div style="font-size:13px; font-family:'JetBrains Mono',monospace; color:rgba(255,247,205,0.7); letter-spacing:0.1em; margin-bottom:12px;">orestes.app</div>
            <h3 style="font-size:24px; font-weight:800; color:#FFF7CD; margin:0 0 10px 0;">Orestes</h3>
            <p style="font-size:13px; color:#a79f8e; line-height:1.55; margin:0 0 16px 0;">Plataforma fullstack de gestión de datos para PyMEs</p>
            <div style="padding:6px 10px; background:rgba(255,255,255,0.04); display:inline-block; border:1px solid rgba(255,255,255,0.08);">
              <span style="font-size:11px; color:#a79f8e; font-weight:600;">React · Express · PostgreSQL</span>
            </div>
          </div>

          <!-- Deck -->
          <div style="padding:28px 24px; background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.06); position:relative; overflow:hidden;">
            <div style="position:absolute; top:0; left:0; right:0; height:2px; background:rgba(255,255,255,0.1);"></div>
            <div style="font-size:13px; font-family:'JetBrains Mono',monospace; color:rgba(255,247,205,0.5); letter-spacing:0.1em; margin-bottom:12px;">deck.app</div>
            <h3 style="font-size:24px; font-weight:800; color:#FFF7CD; margin:0 0 10px 0;">Deck</h3>
            <p style="font-size:13px; color:#a79f8e; line-height:1.55; margin:0 0 16px 0;">Presentaciones dinámicas y modulares para comunicación técnica</p>
            <div style="padding:6px 10px; background:rgba(255,255,255,0.03); display:inline-block;">
              <span style="font-size:11px; color:#a79f8e; font-weight:600;">Astro · Reveal.js</span>
            </div>
          </div>
        </div>

        <p style="margin-top:24px; font-size:13px; color:rgba(167,159,142,0.4); font-style:italic;">Todos los productos construidos con arquitecturas modernas y sin licencias extranjeras</p>
      </div>
    </div>
  </div>
</section>
