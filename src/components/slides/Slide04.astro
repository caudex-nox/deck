---
---
<section id="slide-04">
  <div class="slide-content" style="background:#121212; width:100%; height:100%; overflow:hidden; font-family:'Inter',sans-serif;">
    <div style="position:relative; width:100%; height:100%; display:flex; align-items:center; justify-content:center;">

      <div style="position:absolute; left:0; top:0; width:50%; height:100%; background:linear-gradient(to right, rgba(255,247,205,0.02) 0%, transparent 100%);"></div>
      <div style="position:absolute; top:28px; right:48px; font-size:11px; color:rgba(167,159,142,0.3); font-weight:600; letter-spacing:0.15em;">05 / 20</div>

      <div style="position:relative; z-index:10; max-width:960px; width:100%; padding:0 64px;">

        <p class="s04-label" style="font-size:11px; color:#FFF7CD; letter-spacing:0.25em; text-transform:uppercase; font-weight:600; margin:0 0 14px 0; opacity:0;">Nuestros Productos</p>
        <h2 class="s04-title" style="font-size:42px; font-weight:800; color:#FFF7CD; margin:0 0 32px 0; letter-spacing:-0.02em; opacity:0;">Tres soluciones.<br/><span style="color:#FAF0B5;">Un ecosistema.</span></h2>

        <!-- 3 productos: Orestes | Kanon | Deck -->
        <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:16px;">

          <!-- Orestes — fondo neutro/blanco suave (logo blanco) -->
          <div class="s04-card" style="padding:28px 24px; background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.12); position:relative; overflow:hidden; opacity:0;">
            <div style="position:absolute; top:0; left:0; right:0; height:2px; background:rgba(255,255,255,0.25);"></div>
            <!-- Logo Orestes (blanco, sobre fondo oscuro neutro) -->
            <div style="display:flex; align-items:center; justify-content:center; height:52px; margin-bottom:16px;">
              <img src="/images/orestes.svg" alt="Orestes" style="height:36px; width:auto; object-fit:contain; filter:brightness(1);" />
            </div>
            <p style="font-size:13px; color:#a79f8e; line-height:1.5; margin:0 0 14px 0;">Plataforma fullstack de gestión de datos para PyMEs.</p>
            <div style="padding:5px 10px; background:rgba(255,255,255,0.05); display:inline-block; border:1px solid rgba(255,255,255,0.1);">
              <span style="font-size:11px; color:#a79f8e; font-weight:600;">React · Express · PostgreSQL</span>
            </div>
          </div>

          <!-- Kanon — fondo azul oscuro (logo azul/celeste) -->
          <div class="s04-card" style="padding:28px 24px; background:rgba(14,28,60,0.85); border:1px solid rgba(80,140,220,0.35); position:relative; overflow:hidden; opacity:0;">
            <div style="position:absolute; top:0; left:0; right:0; height:2px; background:linear-gradient(to right, #4a90d9, #7ab8f5);"></div>
            <!-- Logo Kanon (png con tonos azul/celeste) -->
            <div style="display:flex; align-items:center; justify-content:center; height:52px; margin-bottom:16px;">
              <img src="/images/kanon.png" alt="Kanon" style="height:40px; width:auto; object-fit:contain;" />
            </div>
            <p style="font-size:13px; color:#8ab4e8; line-height:1.5; margin:0 0 14px 0;">Sistema integral de inventario y stock para instituciones educativas.</p>
            <div style="padding:5px 10px; background:rgba(74,144,217,0.12); display:inline-block; border:1px solid rgba(74,144,217,0.3);">
              <span style="font-size:11px; color:#7ab8f5; font-weight:600;">Colegios · ETP · Stock</span>
            </div>
          </div>

          <!-- Deck — fondo azul marino con toque dorado (logo azul+dorado) -->
          <div class="s04-card" style="padding:28px 24px; background:rgba(10,20,45,0.85); border:1px solid rgba(60,100,200,0.3); position:relative; overflow:hidden; opacity:0;">
            <div style="position:absolute; top:0; left:0; right:0; height:2px; background:linear-gradient(to right, #3b5fc0, #FFF7CD);"></div>
            <!-- Logo Deck (svg azul con amarillo) -->
            <div style="display:flex; align-items:center; justify-content:center; height:52px; margin-bottom:16px;">
              <img src="/images/deck.svg" alt="Deck" style="height:36px; width:auto; object-fit:contain;" />
            </div>
            <p style="font-size:13px; color:#8a9ec0; line-height:1.5; margin:0 0 14px 0;">Presentaciones dinámicas y modulares para comunicación técnica.</p>
            <div style="padding:5px 10px; background:rgba(59,95,192,0.1); display:inline-block; border:1px solid rgba(59,95,192,0.25);">
              <span style="font-size:11px; color:#8aa8e8; font-weight:600;">Astro · Reveal.js</span>
            </div>
          </div>
        </div>

        <p class="s04-footer" style="margin-top:20px; font-size:13px; color:rgba(167,159,142,0.4); font-style:italic; opacity:0;">Todos los productos construidos con arquitecturas modernas y sin licencias extranjeras</p>
      </div>
    </div>
  </div>
</section>

<style>
  .s04-card {
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .s04-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.4);
  }
</style>

<script>
  import { animate } from "motion";

  const slide = document.getElementById("slide-04");

  function runSlide04Animations() {
    if (!slide) return;

    const label = slide.querySelector(".s04-label");
    if (label) animate(label, { opacity: [0, 1], y: [-8, 0] }, { duration: 0.4 });

    const title = slide.querySelector(".s04-title");
    if (title) animate(title, { opacity: [0, 1], y: [-10, 0] }, { duration: 0.5, delay: 0.1, ease: [0.16, 1, 0.3, 1] });

    // Tarjetas entran con zoom sutil escalonado
    const cards = slide.querySelectorAll(".s04-card");
    cards.forEach((card, i) => {
      animate(
        card,
        { opacity: [0, 1], scale: [0.9, 1], y: [20, 0] },
        { duration: 0.6, delay: 0.2 + i * 0.15, ease: [0.16, 1, 0.3, 1] }
      );
    });

    const footer = slide.querySelector(".s04-footer");
    if (footer) animate(footer, { opacity: [0, 0.4] }, { duration: 0.5, delay: 0.75 });
  }

  slide?.addEventListener("slide:enter", runSlide04Animations);
  if (slide?.closest("section.present") || slide?.classList.contains("present")) {
    runSlide04Animations();
  }
</script>
