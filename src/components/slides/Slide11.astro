---
import { DollarSign, Play, Layers, Users } from '@lucide/astro';
---
<!-- Slide 11 — Propuesta de Valor / ¿Por qué Caudex? -->
<section id="slide-11">
  <div class="slide-content" style="background:#121212; width:100%; height:100%; overflow:hidden; font-family:'Inter',sans-serif;">
    <div style="position:relative; width:100%; height:100%; display:flex; align-items:center; justify-content:center;">

      <!-- Imagen fondo split -->
      <div style="position:absolute; right:0; top:0; width:40%; height:100%; overflow:hidden;">
        <img src="/images/slide_remote_work.webp" alt="" style="width:100%; height:100%; object-fit:cover; opacity:0.07; filter:grayscale(100%);" />
        <div style="position:absolute; inset:0; background:linear-gradient(to right, #121212 0%, transparent 60%);"></div>
      </div>

      <div style="position:absolute; top:28px; right:48px; font-size:11px; color:rgba(167,159,142,0.3); font-weight:600; letter-spacing:0.15em;">18 / 20</div>

      <div style="position:relative; z-index:10; max-width:960px; width:100%; padding:0 64px;">

        <p class="s11-label" style="font-size:11px; color:#FFF7CD; letter-spacing:0.25em; text-transform:uppercase; font-weight:600; margin:0 0 14px 0; opacity:0;">Propuesta de Valor</p>
        <h2 class="s11-title" style="font-size:48px; font-weight:800; color:#FFF7CD; margin:0 0 24px 0; line-height:1.1; letter-spacing:-0.02em; max-width:520px; opacity:0;">¿Por qué elegir<br/><span style="color:#FAF0B5;">Caudex?</span></h2>

        <div style="display:flex; flex-direction:column; gap:11px; max-width:540px;">

          <div class="s11-item" style="display:flex; gap:16px; align-items:center; padding:13px 16px; background:rgba(255,247,205,0.06); border:1px solid rgba(255,247,205,0.25); border-radius:3px; opacity:0;">
            <div style="color:#FFF7CD; flex-shrink:0;"><DollarSign size={18} stroke-width={2} /></div>
            <div>
              <div style="font-size:14px; font-weight:700; color:#FFF7CD; margin-bottom:2px;">Sin licencias en dólares</div>
              <div style="font-size:14px; color:#a79f8e;">Pesos · costo-beneficio</div>
            </div>
          </div>

          <div class="s11-item" style="display:flex; gap:16px; align-items:center; padding:13px 16px; background:rgba(255,255,255,0.03); border:1px solid rgba(255,247,205,0.18); border-radius:3px; opacity:0;">
            <div style="color:#FFF7CD; flex-shrink:0;"><Play size={18} stroke-width={2} /></div>
            <div>
              <div style="font-size:14px; font-weight:700; color:#FFF7CD; margin-bottom:2px;">Piloto bonificado 30 días</div>
              <div style="font-size:14px; color:#a79f8e;">Probalo sin riesgo</div>
            </div>
          </div>

          <div class="s11-item" style="display:flex; gap:16px; align-items:center; padding:13px 16px; background:rgba(255,255,255,0.02); border:1px solid rgba(255,247,205,0.12); border-radius:3px; opacity:0;">
            <div style="color:#FFF7CD; flex-shrink:0;"><Layers size={18} stroke-width={2} /></div>
            <div>
              <div style="font-size:14px; font-weight:700; color:#FFF7CD; margin-bottom:2px;">Arquitectura escalable</div>
              <div style="font-size:14px; color:#a79f8e;">Modular · disponible 24/7</div>
            </div>
          </div>

          <div class="s11-item" style="display:flex; gap:16px; align-items:center; padding:13px 16px; background:rgba(255,255,255,0.02); border:1px solid rgba(255,247,205,0.08); border-radius:3px; opacity:0;">
            <div style="color:#FFF7CD; flex-shrink:0;"><Users size={18} stroke-width={2} /></div>
            <div>
              <div style="font-size:14px; font-weight:700; color:#FFF7CD; margin-bottom:2px;">Equipo técnico directo</div>
              <div style="font-size:14px; color:#a79f8e;">Cercanía técnica directa</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .s11-item {
    transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }
  .s11-item:hover {
    transform: translateX(4px);
    border-color: rgba(255,247,205,0.5);
    background: rgba(255,247,205,0.1);
  }
</style>

<script>
  import { animate } from "motion";
  const slide = document.getElementById("slide-11");

  function runSlide11Animations() {
    if (!slide) return;

    const label = slide.querySelector(".s11-label");
    if (label) animate(label, { opacity: [0, 1], x: [-18, 0] }, { duration: 0.4 });

    const title = slide.querySelector(".s11-title");
    if (title) animate(title, { opacity: [0, 1], x: [-22, 0] }, { duration: 0.6, delay: 0.1, ease: [0.16, 1, 0.3, 1] });

    const items = slide.querySelectorAll(".s11-item");
    items.forEach((item, i) => {
      animate(
        item,
        { opacity: [0, 1], y: [14, 0] },
        { duration: 0.5, delay: 0.2 + i * 0.1, ease: [0.16, 1, 0.3, 1] }
      );
    });

    items.forEach((item, i) => {
      animate(item, { borderColor: ["rgba(255,247,205,0.25)", "rgba(255,247,205,0.48)", "rgba(255,247,205,0.25)"] }, { duration: 3.5, delay: 1.2 + i * 0.25, repeat: Infinity, ease: "easeInOut" });
    });
  }

  slide?.addEventListener("slide:enter", runSlide11Animations);
  if (slide?.closest("section.present") || slide?.classList.contains("present")) {
    runSlide11Animations();
  }
</script>
