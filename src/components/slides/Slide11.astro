<section>
  <div class="slide-content" style="background:#121212; width:100%; height:100%; overflow:hidden; font-family:'Inter',sans-serif;">
    <div style="position:relative; width:100%; height:100%; display:flex; align-items:center; justify-content:center;">

      <!-- Fondo split con imagen muy sutil -->
      <div style="position:absolute; right:0; top:0; width:40%; height:100%; overflow:hidden;">
        <img src="/images/slide_remote_work.webp" alt="" style="width:100%; height:100%; object-fit:cover; opacity:0.08; filter:grayscale(100%);" />
        <div style="position:absolute; inset:0; background:linear-gradient(to right, #121212 0%, transparent 60%);"></div>
      </div>

      <!-- Número de slide (superior derecho) -->
      <div style="position:absolute; top:28px; right:48px; font-size:11px; color:rgba(167,159,142,0.3); font-weight:600; letter-spacing:0.15em;">11 / 15</div>

      <div style="position:relative; z-index:10; max-width:960px; width:100%; padding:0 64px;">

        <p style="font-size:11px; color:#FFF7CD; letter-spacing:0.25em; text-transform:uppercase; font-weight:600; margin:0 0 16px 0;">Propuesta de Valor</p>
        <h2 style="font-size:44px; font-weight:800; color:#FFF7CD; margin:0 0 28px 0; line-height:1.1; letter-spacing:-0.02em; max-width:560px;">¿Por qué elegir<br/><span style="color:#FAF0B5;">Caudex?</span></h2>

        <div style="display:flex; flex-direction:column; gap:14px; max-width:560px;">

          <div style="display:flex; gap:20px; align-items:flex-start; padding:16px; background:rgba(255,247,205,0.06); border:1px solid rgba(255,247,205,0.25);">
            <div style="font-size:28px; font-weight:900; color:#FFF7CD; line-height:1; min-width:36px;">01</div>
            <div>
              <div style="font-size:15px; font-weight:700; color:#FFF7CD; margin-bottom:4px;">Sin licencias en dólares</div>
              <div style="font-size:13px; color:#a79f8e;">Software a medida cobrado en pesos con relación costo-beneficio óptima</div>
            </div>
          </div>

          <div style="display:flex; gap:20px; align-items:flex-start; padding:16px; background:rgba(255,255,255,0.03); border:1px solid rgba(255,247,205,0.15);">
            <div style="font-size:28px; font-weight:900; color:#FAF0B5; line-height:1; min-width:36px;">02</div>
            <div>
              <div style="font-size:15px; font-weight:700; color:#FFF7CD; margin-bottom:4px;">Piloto gratuito 30 días</div>
              <div style="font-size:13px; color:#a79f8e;">Adoptá el sistema sin riesgo antes de comprometerte</div>
            </div>
          </div>

          <div style="display:flex; gap:20px; align-items:flex-start; padding:16px; background:rgba(255,255,255,0.02); border:1px solid rgba(255,247,205,0.1);">
            <div style="font-size:28px; font-weight:900; color:rgba(255,247,205,0.6); line-height:1; min-width:36px;">03</div>
            <div>
              <div style="font-size:15px; font-weight:700; color:#FFF7CD; margin-bottom:4px;">Arquitectura escalable</div>
              <div style="font-size:13px; color:#a79f8e;">React + Express + PostgreSQL · Disponible 24/7 en la nube</div>
            </div>
          </div>

          <div style="display:flex; gap:20px; align-items:flex-start; padding:16px; background:rgba(255,255,255,0.02); border:1px solid rgba(255,247,205,0.08);">
            <div style="font-size:28px; font-weight:900; color:rgba(255,247,205,0.4); line-height:1; min-width:36px;">04</div>
            <div>
              <div style="font-size:15px; font-weight:700; color:#FFF7CD; margin-bottom:4px;">Equipo técnico directo</div>
              <div style="font-size:13px; color:#a79f8e;">Sin intermediarios. Los desarrolladores conocen tu lógica de negocio</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
