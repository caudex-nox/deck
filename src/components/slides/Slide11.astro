---
import { DollarSign, Play, Layers, Users } from '@lucide/astro';
---
<!-- Slide 11 — Propuesta de Valor / ¿Por qué Caudex? -->
<section id="slide-11">
  <div class="slide-content" style="background:#121212; width:100%; height:100%; overflow:hidden; font-family:'Inter',sans-serif;">
    <div style="position:relative; width:100%; height:100%; display:flex; align-items:center; justify-content:center;">

      <!-- Imagen fondo split -->
      <div style="position:absolute; right:0; top:0; width:40%; height:100%; overflow:hidden;">
        <img src="/images/slide_remote_work.webp" alt="" style="width:100%; height:100%; object-fit:cover; opacity:0.07; filter:grayscale(100%);" />
        <div style="position:absolute; inset:0; background:linear-gradient(to right, #121212 0%, transparent 60%);"></div>
      </div>

      <div style="position:absolute; top:28px; right:48px; font-size:11px; color:rgba(167,159,142,0.3); font-weight:600; letter-spacing:0.15em;">18 / 20</div>

      <div style="position:relative; z-index:10; max-width:960px; width:100%; padding:0 64px;">

        <p class="s11-label" style="font-size:11px; color:#FFF7CD; letter-spacing:0.25em; text-transform:uppercase; font-weight:600; margin:0 0 14px 0; opacity:0;">Propuesta de Valor</p>
        <h2 class="s11-title" style="font-size:44px; font-weight:800; color:#FFF7CD; margin:0 0 26px 0; line-height:1.1; letter-spacing:-0.02em; max-width:520px; opacity:0;">¿Por qué elegir<br/><span style="color:#FAF0B5;">Caudex?</span></h2>

        <div style="display:flex; flex-direction:column; gap:12px; max-width:540px;">

          <div class="s11-item" style="display:flex; gap:16px; align-items:flex-start; padding:14px; background:rgba(255,247,205,0.06); border:1px solid rgba(255,247,205,0.25); opacity:0;">
            <div style="color:#FFF7CD; flex-shrink:0; margin-top:2px;"><DollarSign size={18} stroke-width={1.8} /></div>
            <div>
              <div style="font-size:14px; font-weight:700; color:#FFF7CD; margin-bottom:3px;">Sin licencias en dólares</div>
              <div style="font-size:12px; color:#a79f8e;">Software a medida cobrado en pesos, relación costo-beneficio óptima.</div>
            </div>
          </div>

          <div class="s11-item" style="display:flex; gap:16px; align-items:flex-start; padding:14px; background:rgba(255,255,255,0.03); border:1px solid rgba(255,247,205,0.15); opacity:0;">
            <div style="color:#FFF7CD; flex-shrink:0; margin-top:2px;"><Play size={18} stroke-width={1.8} /></div>
            <div>
              <div style="font-size:14px; font-weight:700; color:#FFF7CD; margin-bottom:3px;">Piloto gratuito 30 días</div>
              <div style="font-size:12px; color:#a79f8e;">Adoptá el sistema sin riesgo antes de comprometerte.</div>
            </div>
          </div>

          <div class="s11-item" style="display:flex; gap:16px; align-items:flex-start; padding:14px; background:rgba(255,255,255,0.02); border:1px solid rgba(255,247,205,0.1); opacity:0;">
            <div style="color:#FFF7CD; flex-shrink:0; margin-top:2px;"><Layers size={18} stroke-width={1.8} /></div>
            <div>
              <div style="font-size:14px; font-weight:700; color:#FFF7CD; margin-bottom:3px;">Arquitectura escalable</div>
              <div style="font-size:12px; color:#a79f8e;">React + Express + PostgreSQL · Disponible 24/7 en la nube.</div>
            </div>
          </div>

          <div class="s11-item" style="display:flex; gap:16px; align-items:flex-start; padding:14px; background:rgba(255,255,255,0.02); border:1px solid rgba(255,247,205,0.08); opacity:0;">
            <div style="color:#FFF7CD; flex-shrink:0; margin-top:2px;"><Users size={18} stroke-width={1.8} /></div>
            <div>
              <div style="font-size:14px; font-weight:700; color:#FFF7CD; margin-bottom:3px;">Equipo técnico directo</div>
              <div style="font-size:12px; color:#a79f8e;">Sin intermediarios. Los desarrolladores conocen tu lógica de negocio.</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { animate } from "motion";
  const slide = document.getElementById("slide-11");

  function runSlide11Animations() {
    if (!slide) return;

    const label = slide.querySelector(".s11-label");
    if (label) animate(label, { opacity: [0, 1], x: [-18, 0] }, { duration: 0.4 });

    const title = slide.querySelector(".s11-title");
    if (title) animate(title, { opacity: [0, 1], x: [-22, 0] }, { duration: 0.6, delay: 0.1, ease: [0.16, 1, 0.3, 1] });

    // Items: cada uno entra escalonado con fade desde abajo ligeramente
    const items = slide.querySelectorAll(".s11-item");
    items.forEach((item, i) => {
      animate(
        item,
        { opacity: [0, 1], y: [14, 0] },
        { duration: 0.5, delay: 0.25 + i * 0.13, ease: [0.16, 1, 0.3, 1] }
      );
    });
  }

  slide?.addEventListener("slide:enter", runSlide11Animations);
  if (slide?.closest("section.present") || slide?.classList.contains("present")) {
    runSlide11Animations();
  }
</script>
