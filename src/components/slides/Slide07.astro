---
---
<section>
  <div class="slide-content" style="background:#121212; width:100%; height:100%; overflow:hidden; font-family:'Inter',sans-serif;">
    <div style="position:relative; width:100%; height:100%; display:flex; align-items:center; justify-content:center;">

      <div style="position:absolute; inset:0; background:radial-gradient(ellipse 60% 60% at 50% 50%, rgba(255,247,205,0.04) 0%, transparent 70%);"></div>

      <!-- Número de slide (superior derecho) -->
      <div style="position:absolute; top:28px; right:48px; font-size:11px; color:rgba(167,159,142,0.3); font-weight:600; letter-spacing:0.15em;">07 / 15</div>

      <div style="position:relative; z-index:10; max-width:960px; width:100%; padding:0 64px;">

        <p style="font-size:11px; color:#FFF7CD; letter-spacing:0.25em; text-transform:uppercase; font-weight:600; margin:0 0 12px 0;">5 Fuerzas Competitivas · Porter</p>
        <h2 style="font-size:36px; font-weight:800; color:#FFF7CD; margin:0 0 28px 0; letter-spacing:-0.02em;">El ecosistema <span style="color:#FAF0B5;">competitivo</span></h2>

        <!-- 5 fuerzas como lista con barras -->
        <div style="display:flex; flex-direction:column; gap:10px;">

          <!-- Rivalidad -->
          <div style="display:grid; grid-template-columns:220px 1fr 110px; gap:16px; align-items:center; padding:14px 18px; background:rgba(255,255,255,0.03); border:1px solid rgba(255,247,205,0.1);">
            <div style="font-size:14px; font-weight:600; color:#FFF7CD;">Rivalidad existente</div>
            <div style="height:4px; background:rgba(255,255,255,0.07); border-radius:2px; overflow:hidden;">
              <div style="height:100%; width:65%; background:linear-gradient(to right, #FFF7CD, #FAF0B5); border-radius:2px;"></div>
            </div>
            <div style="font-size:12px; color:#FAF0B5; font-weight:700; text-align:right;">Media-Alta</div>
          </div>

          <!-- Nuevos entrantes -->
          <div style="display:grid; grid-template-columns:220px 1fr 110px; gap:16px; align-items:center; padding:14px 18px; background:rgba(255,247,205,0.05); border:1px solid rgba(255,247,205,0.25);">
            <div style="font-size:14px; font-weight:600; color:#FFF7CD;">Nuevos entrantes</div>
            <div style="height:4px; background:rgba(255,255,255,0.07); border-radius:2px; overflow:hidden;">
              <div style="height:100%; width:80%; background:linear-gradient(to right, #FFF7CD, #FAF0B5); border-radius:2px;"></div>
            </div>
            <div style="font-size:12px; color:#FFF7CD; font-weight:700; text-align:right;">Alta</div>
          </div>

          <!-- Poder clientes -->
          <div style="display:grid; grid-template-columns:220px 1fr 110px; gap:16px; align-items:center; padding:14px 18px; background:rgba(255,255,255,0.03); border:1px solid rgba(255,247,205,0.1);">
            <div style="font-size:14px; font-weight:600; color:#FFF7CD;">Poder clientes</div>
            <div style="height:4px; background:rgba(255,255,255,0.07); border-radius:2px; overflow:hidden;">
              <div style="height:100%; width:60%; background:linear-gradient(to right, #FFF7CD, #FAF0B5); border-radius:2px;"></div>
            </div>
            <div style="font-size:12px; color:#FAF0B5; font-weight:700; text-align:right;">Medio-Alto</div>
          </div>

          <!-- Poder proveedores -->
          <div style="display:grid; grid-template-columns:220px 1fr 110px; gap:16px; align-items:center; padding:14px 18px; background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.05);">
            <div style="font-size:14px; font-weight:600; color:#a79f8e;">Poder proveedores</div>
            <div style="height:4px; background:rgba(255,255,255,0.06); border-radius:2px; overflow:hidden;">
              <div style="height:100%; width:20%; background:rgba(255,247,205,0.4); border-radius:2px;"></div>
            </div>
            <div style="font-size:12px; color:#a79f8e; font-weight:700; text-align:right;">Bajo</div>
          </div>

          <!-- Sustitutos -->
          <div style="display:grid; grid-template-columns:220px 1fr 110px; gap:16px; align-items:center; padding:14px 18px; background:rgba(255,247,205,0.05); border:1px solid rgba(255,247,205,0.25);">
            <div style="font-size:14px; font-weight:600; color:#FFF7CD;">Productos sustitutos</div>
            <div style="height:4px; background:rgba(255,255,255,0.07); border-radius:2px; overflow:hidden;">
              <div style="height:100%; width:82%; background:linear-gradient(to right, #FFF7CD, #FAF0B5); border-radius:2px;"></div>
            </div>
            <div style="font-size:12px; color:#FFF7CD; font-weight:700; text-align:right;">Alta</div>
          </div>
        </div>

        <p style="margin-top:20px; font-size:13px; color:#a79f8e; font-style:italic;">No-code, IA y Excel como competidores indirectos en etapas tempranas de digitalización</p>
      </div>
    </div>
  </div>
</section>
