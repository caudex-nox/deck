---
<!-- Slide 07 — 5 Fuerzas de Porter — barras con fill animado -->
<section id="slide-07">
  <div class="slide-content" style="background:#121212; width:100%; height:100%; overflow:hidden; font-family:'Inter',sans-serif;">
    <div style="position:relative; width:100%; height:100%; display:flex; align-items:center; justify-content:center;">

      <div style="position:absolute; inset:0; background:radial-gradient(ellipse 60% 60% at 50% 50%, rgba(255,247,205,0.04) 0%, transparent 70%);"></div>
      <div style="position:absolute; top:28px; right:48px; font-size:11px; color:rgba(167,159,142,0.3); font-weight:600; letter-spacing:0.15em;">08 / 20</div>

      <div style="position:relative; z-index:10; max-width:960px; width:100%; padding:0 64px;">
        <p class="s07-label" style="font-size:11px; color:#FFF7CD; letter-spacing:0.25em; text-transform:uppercase; font-weight:600; margin:0 0 10px 0; opacity:0;">5 Fuerzas Competitivas · Porter</p>
        <h2 class="s07-title" style="font-size:36px; font-weight:800; color:#FFF7CD; margin:0 0 24px 0; letter-spacing:-0.02em; opacity:0;">El ecosistema <span style="color:#FAF0B5;">competitivo</span></h2>

        <div style="display:flex; flex-direction:column; gap:10px;">

          <div class="s07-row" style="display:grid; grid-template-columns:200px 1fr 110px; gap:16px; align-items:center; padding:13px 18px; background:rgba(255,247,205,0.05); border:1px solid rgba(255,247,205,0.25); opacity:0;">
            <div style="font-size:14px; font-weight:600; color:#FFF7CD;">Rivalidad existente</div>
            <div style="height:4px; background:rgba(255,255,255,0.07); border-radius:2px; overflow:hidden;">
              <div class="s07-bar" data-width="65" style="height:100%; width:0%; background:linear-gradient(to right, #FFF7CD, #FAF0B5); border-radius:2px;"></div>
            </div>
            <div style="font-size:12px; color:#FAF0B5; font-weight:700; text-align:right;">Media-Alta</div>
          </div>

          <div class="s07-row" style="display:grid; grid-template-columns:200px 1fr 110px; gap:16px; align-items:center; padding:13px 18px; background:rgba(255,247,205,0.07); border:1px solid rgba(255,247,205,0.3); opacity:0;">
            <div style="font-size:14px; font-weight:600; color:#FFF7CD;">Nuevos entrantes</div>
            <div style="height:4px; background:rgba(255,255,255,0.07); border-radius:2px; overflow:hidden;">
              <div class="s07-bar" data-width="80" style="height:100%; width:0%; background:linear-gradient(to right, #FFF7CD, #FAF0B5); border-radius:2px;"></div>
            </div>
            <div style="font-size:12px; color:#FFF7CD; font-weight:700; text-align:right;">Alta</div>
          </div>

          <div class="s07-row" style="display:grid; grid-template-columns:200px 1fr 110px; gap:16px; align-items:center; padding:13px 18px; background:rgba(255,255,255,0.03); border:1px solid rgba(255,247,205,0.1); opacity:0;">
            <div style="font-size:14px; font-weight:600; color:#FFF7CD;">Poder clientes</div>
            <div style="height:4px; background:rgba(255,255,255,0.07); border-radius:2px; overflow:hidden;">
              <div class="s07-bar" data-width="60" style="height:100%; width:0%; background:linear-gradient(to right, #FFF7CD, #FAF0B5); border-radius:2px;"></div>
            </div>
            <div style="font-size:12px; color:#FAF0B5; font-weight:700; text-align:right;">Medio-Alto</div>
          </div>

          <div class="s07-row" style="display:grid; grid-template-columns:200px 1fr 110px; gap:16px; align-items:center; padding:13px 18px; background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.05); opacity:0;">
            <div style="font-size:14px; font-weight:600; color:#a79f8e;">Poder proveedores</div>
            <div style="height:4px; background:rgba(255,255,255,0.06); border-radius:2px; overflow:hidden;">
              <div class="s07-bar" data-width="20" style="height:100%; width:0%; background:rgba(255,247,205,0.4); border-radius:2px;"></div>
            </div>
            <div style="font-size:12px; color:#a79f8e; font-weight:700; text-align:right;">Bajo</div>
          </div>

          <div class="s07-row" style="display:grid; grid-template-columns:200px 1fr 110px; gap:16px; align-items:center; padding:13px 18px; background:rgba(255,247,205,0.05); border:1px solid rgba(255,247,205,0.25); opacity:0;">
            <div style="font-size:14px; font-weight:600; color:#FFF7CD;">Productos sustitutos</div>
            <div style="height:4px; background:rgba(255,255,255,0.07); border-radius:2px; overflow:hidden;">
              <div class="s07-bar" data-width="82" style="height:100%; width:0%; background:linear-gradient(to right, #FFF7CD, #FAF0B5); border-radius:2px;"></div>
            </div>
            <div style="font-size:12px; color:#FFF7CD; font-weight:700; text-align:right;">Alta</div>
          </div>
        </div>

        <p class="s07-note" style="margin-top:16px; font-size:12px; color:#a79f8e; font-style:italic; opacity:0;">No-code, IA y Excel como competidores indirectos en etapas tempranas de digitalización</p>
      </div>
    </div>
  </div>
</section>

<script>
  import { animate } from "motion";
  const slide = document.getElementById("slide-07");

  function runSlide07Animations() {
    if (!slide) return;

    const label = slide.querySelector(".s07-label");
    if (label) animate(label, { opacity: [0, 1], y: [-8, 0] }, { duration: 0.4 });

    const title = slide.querySelector(".s07-title");
    if (title) animate(title, { opacity: [0, 1], y: [-8, 0] }, { duration: 0.5, delay: 0.1 });

    const rows = slide.querySelectorAll(".s07-row");
    rows.forEach((row, i) => {
      // Fila entra desde la derecha
      animate(row, { opacity: [0, 1], x: [40, 0] }, { duration: 0.5, delay: 0.2 + i * 0.1, ease: [0.16, 1, 0.3, 1] })
        .then(() => {
          // Barra anima su width tras la entrada de la fila
          const bar = row.querySelector(".s07-bar");
          const targetWidth = bar?.getAttribute("data-width") || "0";
          if (bar) {
            animate(bar, { width: ["0%", `${targetWidth}%`] }, { duration: 0.7, ease: [0.16, 1, 0.3, 1] });
          }
        });
    });

    const note = slide.querySelector(".s07-note");
    if (note) animate(note, { opacity: [0, 1] }, { duration: 0.5, delay: 1.0 });
  }

  slide?.addEventListener("slide:enter", runSlide07Animations);
  if (slide?.closest("section.present") || slide?.classList.contains("present")) {
    runSlide07Animations();
  }
</script>
