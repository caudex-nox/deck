---
---
<section>
  <div class="slide-content" style="background:#121212; width:100%; height:100%; overflow:hidden; font-family:'Inter',sans-serif;">
    <div style="position:relative; width:100%; height:100%; display:flex; align-items:center; justify-content:center;">

      <!-- Líneas decorativas top + bottom -->
      <div style="position:absolute; top:0; left:0; right:0; height:3px; background:linear-gradient(to right, transparent, #FFF7CD 40%, #FAF0B5 60%, transparent);"></div>
      <div style="position:absolute; bottom:0; left:0; right:0; height:1px; background:rgba(255,247,205,0.15);"></div>

      <!-- Número de slide (superior derecho) -->
      <div style="position:absolute; top:28px; right:48px; font-size:11px; color:rgba(167,159,142,0.3); font-weight:600; letter-spacing:0.15em;">14 / 15</div>

      <div style="position:relative; z-index:10; max-width:900px; width:100%; padding:0 64px; text-align:center;">

        <p style="font-size:11px; color:#FFF7CD; letter-spacing:0.25em; text-transform:uppercase; font-weight:600; margin:0 0 28px 0;">Conclusión</p>

        <!-- Texto principal grande -->
        <h2 style="font-size:42px; font-weight:800; color:#FFF7CD; margin:0 0 12px 0; line-height:1.2; letter-spacing:-0.02em;">Una propuesta <span style="color:#FAF0B5;">viable</span><br/>y diferenciada</h2>

        <p style="font-size:16px; color:#a79f8e; max-width:660px; margin:0 auto 40px; line-height:1.65;">Caudex responde directamente a los desafíos tecnológicos y presupuestarios del contexto argentino con soluciones modernas, escalables y accesibles.</p>

        <!-- 3 pilares en fila -->
        <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:12px; margin-bottom:36px;">
          <div style="padding:20px; background:rgba(255,247,205,0.06); border:1px solid rgba(255,247,205,0.25);">
            <div style="font-size:11px; color:#FFF7CD; letter-spacing:0.15em; font-weight:600; margin-bottom:8px;">VIABILIDAD</div>
            <div style="font-size:14px; color:#FFF7CD; line-height:1.4;">Costos bajos, open source, modelo SaaS sin instalación</div>
          </div>
          <div style="padding:20px; background:rgba(255,255,255,0.03); border:1px solid rgba(255,247,205,0.15);">
            <div style="font-size:11px; color:#FAF0B5; letter-spacing:0.15em; font-weight:600; margin-bottom:8px;">DIFERENCIACIÓN</div>
            <div style="font-size:14px; color:#a79f8e; line-height:1.4;">Software a medida, en pesos, con soporte técnico directo</div>
          </div>
          <div style="padding:20px; background:rgba(255,255,255,0.02); border:1px solid rgba(255,247,205,0.1);">
            <div style="font-size:11px; color:rgba(255,247,205,0.6); letter-spacing:0.15em; font-weight:600; margin-bottom:8px;">ESCALABILIDAD</div>
            <div style="font-size:14px; color:#a79f8e; line-height:1.4;">Arquitectura fullstack preparada para crecer con el cliente</div>
          </div>
        </div>

        <!-- Línea final con productos -->
        <div style="display:flex; align-items:center; justify-content:center; gap:16px;">
          <div style="height:1px; width:60px; background:rgba(255,247,205,0.25);"></div>
          <span style="font-size:13px; color:#a79f8e; font-family:'JetBrains Mono',monospace;">Kanon · Orestes · Deck</span>
          <div style="height:1px; width:60px; background:rgba(255,247,205,0.25);"></div>
        </div>
      </div>
    </div>
  </div>
</section>
