---
---
<section>
  <div class="slide-content" style="background:#121212; width:100%; height:100%; overflow:hidden; font-family:'Inter',sans-serif;">
    <div style="position:relative; width:100%; height:100%; display:flex; align-items:center; justify-content:center;">

      <!-- Línea decorativa derecha -->
      <div style="position:absolute; right:0; top:0; width:4px; height:100%; background: linear-gradient(to bottom, transparent, #FFF7CD, transparent);"></div>

      <!-- Número de slide (superior derecho) -->
      <div style="position:absolute; top:28px; right:48px; font-size:11px; color:rgba(167,159,142,0.3); font-weight:600; letter-spacing:0.15em;">10 / 15</div>

      <div style="position:relative; z-index:10; max-width:960px; width:100%; padding:0 64px;">

        <p style="font-size:11px; color:#FFF7CD; letter-spacing:0.25em; text-transform:uppercase; font-weight:600; margin:0 0 16px 0;">Recursos Humanos</p>
        <h2 style="font-size:40px; font-weight:800; color:#FFF7CD; margin:0 0 32px 0; letter-spacing:-0.02em;">El equipo que<br/><span style="color:#FAF0B5;">ejecuta el plan</span></h2>

        <!-- 4 puestos en grid 2x2 -->
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">

          <!-- PMO -->
          <div style="padding:20px 22px; background:rgba(255,247,205,0.06); border:1px solid rgba(255,247,205,0.25); display:flex; flex-direction:column; gap:8px;">
            <div style="display:flex; justify-content:space-between; align-items:center;">
              <div style="font-size:11px; color:#FFF7CD; letter-spacing:0.15em; font-weight:600;">ROL 01</div>
              <div style="font-size:11px; color:#a79f8e; font-family:'JetBrains Mono',monospace;">40h/sem</div>
            </div>
            <div style="font-size:16px; font-weight:700; color:#FFF7CD;">Project Manager (PMO)</div>
            <div style="font-size:13px; color:#a79f8e; line-height:1.4;">Gestión del ciclo de vida de Kanon y Orestes. Nexo entre cliente y equipo técnico.</div>
          </div>

          <!-- Dev FullStack -->
          <div style="padding:20px 22px; background:rgba(255,247,205,0.04); border:1px solid rgba(255,247,205,0.2); display:flex; flex-direction:column; gap:8px;">
            <div style="display:flex; justify-content:space-between; align-items:center;">
              <div style="font-size:11px; color:#FFF7CD; letter-spacing:0.15em; font-weight:600;">ROL 02</div>
              <div style="font-size:11px; color:#a79f8e; font-family:'JetBrains Mono',monospace;">40h/sem</div>
            </div>
            <div style="font-size:16px; font-weight:700; color:#FFF7CD;">Desarrollador Full-Stack</div>
            <div style="font-size:13px; color:#a79f8e; line-height:1.4;">Frontend + Backend con React, Express, PostgreSQL. Arquitectura escalable.</div>
          </div>

          <!-- Dev Low Level -->
          <div style="padding:20px 22px; background:rgba(255,255,255,0.03); border:1px solid rgba(255,247,205,0.15); display:flex; flex-direction:column; gap:8px;">
            <div style="display:flex; justify-content:space-between; align-items:center;">
              <div style="font-size:11px; color:#FAF0B5; letter-spacing:0.15em; font-weight:600;">ROL 03</div>
              <div style="font-size:11px; color:#a79f8e; font-family:'JetBrains Mono',monospace;">40h/sem</div>
            </div>
            <div style="font-size:16px; font-weight:700; color:#FFF7CD;">Desarrollador Bajo Nivel</div>
            <div style="font-size:13px; color:#a79f8e; line-height:1.4;">Optimización de rendimiento en C/C++. Arquitectura de sistemas eficientes.</div>
          </div>

          <!-- Diseño / UX -->
          <div style="padding:20px 22px; background:rgba(255,255,255,0.02); border:1px solid rgba(255,247,205,0.1); display:flex; flex-direction:column; gap:8px;">
            <div style="display:flex; justify-content:space-between; align-items:center;">
              <div style="font-size:11px; color:rgba(255,247,205,0.7); letter-spacing:0.15em; font-weight:600;">ROL 04</div>
              <div style="font-size:11px; color:#a79f8e; font-family:'JetBrains Mono',monospace;">40h/sem</div>
            </div>
            <div style="font-size:16px; font-weight:700; color:#FFF7CD;">Diseño UI/UX & Comercial</div>
            <div style="font-size:13px; color:#a79f8e; line-height:1.4;">Interfaces intuitivas, experiencia de usuario y gestión comercial / ventas.</div>
          </div>
        </div>

        <!-- Convenio -->
        <div style="margin-top:18px; padding:12px 18px; border-left:3px solid rgba(255,247,205,0.3); background:rgba(255,255,255,0.02);">
          <p style="font-size:13px; color:#a79f8e; margin:0;">Marco legal: Convenio Colectivo CESSI · Modalidad remota/híbrida · Jornada de 40hs semanales</p>
        </div>
      </div>
    </div>
  </div>
</section>
