---
---
<!-- Slide 06 — PEST Macroentorno — textos concisos y animaciones escalonadas -->
<section id="slide-06">
  <div class="slide-content" style="background:#121212; width:100%; height:100%; overflow:hidden; font-family:'Inter',sans-serif;">
    <div style="position:relative; width:100%; height:100%; display:flex; align-items:center; justify-content:center;">

      <div style="position:absolute; top:0; left:0; right:0; height:3px; background: linear-gradient(to right, transparent, #FFF7CD 40%, transparent);"></div>
      <div style="position:absolute; top:28px; right:48px; font-size:11px; color:rgba(167,159,142,0.3); font-weight:600; letter-spacing:0.15em;">07 / 20</div>

      <div style="position:relative; z-index:10; max-width:960px; width:100%; padding:0 64px;">
        <p class="s06-label" style="font-size:11px; color:#FFF7CD; letter-spacing:0.25em; text-transform:uppercase; font-weight:600; margin:0 0 12px 0; opacity:0;">Análisis PEST · Macroentorno</p>
        <h2 class="s06-title" style="font-size:38px; font-weight:800; color:#FFF7CD; margin:0 0 28px 0; letter-spacing:-0.02em; opacity:0;">Contexto que <span style="color:#FAF0B5;">nos impulsa</span></h2>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:14px;">

          <!-- Tecnológica -->
          <div class="s06-card" style="padding:20px; background:rgba(255,247,205,0.06); border:1px solid rgba(255,247,205,0.28); display:flex; gap:16px; align-items:flex-start; border-radius:3px; opacity:0;">
            <div class="s06-badge" style="min-width:42px; height:42px; background:#FFF7CD; display:flex; align-items:center; justify-content:center; font-size:18px; font-weight:900; color:#121212; flex-shrink:0; border-radius:3px;">T</div>
            <div>
              <div style="font-size:14px; font-weight:700; color:#FFF7CD; margin-bottom:4px;">Tecnológica <span style="font-size:10px; color:#121212; background:#FFF7CD; font-weight:800; margin-left:6px; padding:1px 6px; border-radius:2px;">Muy Alto</span></div>
              <p style="font-size:13px; color:#a79f8e; margin:0; line-height:1.45;">Auge de IA y digitalización masiva impulsan la demanda de software moderno.</p>
            </div>
          </div>

          <!-- Económica -->
          <div class="s06-card" style="padding:20px; background:rgba(255,255,255,0.03); border:1px solid rgba(255,247,205,0.2); display:flex; gap:16px; align-items:flex-start; border-radius:3px; opacity:0;">
            <div class="s06-badge" style="min-width:42px; height:42px; background:rgba(255,247,205,0.15); border:1px solid rgba(255,247,205,0.3); display:flex; align-items:center; justify-content:center; font-size:18px; font-weight:900; color:#FFF7CD; flex-shrink:0; border-radius:3px;">E</div>
            <div>
              <div style="font-size:14px; font-weight:700; color:#FFF7CD; margin-bottom:4px;">Económica <span style="font-size:10px; color:#FAF0B5; font-weight:700; background:rgba(255,247,205,0.1); margin-left:6px; padding:1px 6px; border-radius:2px;">Alto</span></div>
              <p style="font-size:13px; color:#a79f8e; margin:0; line-height:1.45;">Restricción presupuestaria y costos en USD impulsan soluciones locales en pesos.</p>
            </div>
          </div>

          <!-- Cultural -->
          <div class="s06-card" style="padding:20px; background:rgba(255,255,255,0.03); border:1px solid rgba(255,247,205,0.2); display:flex; gap:16px; align-items:flex-start; border-radius:3px; opacity:0;">
            <div class="s06-badge" style="min-width:42px; height:42px; background:rgba(255,247,205,0.15); border:1px solid rgba(255,247,205,0.3); display:flex; align-items:center; justify-content:center; font-size:18px; font-weight:900; color:#FFF7CD; flex-shrink:0; border-radius:3px;">C</div>
            <div>
              <div style="font-size:14px; font-weight:700; color:#FFF7CD; margin-bottom:4px;">Cultural <span style="font-size:10px; color:#FAF0B5; font-weight:700; background:rgba(255,247,205,0.1); margin-left:6px; padding:1px 6px; border-radius:2px;">Alto</span></div>
              <p style="font-size:13px; color:#a79f8e; margin:0; line-height:1.45;">79% del sector opera remoto. Fuerte adopción tecnológica en empresas y educación.</p>
            </div>
          </div>

          <!-- Legal -->
          <div class="s06-card" style="padding:20px; background:rgba(255,255,255,0.02); border:1px solid rgba(255,247,205,0.1); display:flex; gap:16px; align-items:flex-start; border-radius:3px; opacity:0;">
            <div class="s06-badge" style="min-width:42px; height:42px; background:rgba(255,255,255,0.05); border:1px solid rgba(255,247,205,0.15); display:flex; align-items:center; justify-content:center; font-size:18px; font-weight:900; color:#a79f8e; flex-shrink:0; border-radius:3px;">L</div>
            <div>
              <div style="font-size:14px; font-weight:700; color:#a79f8e; margin-bottom:4px;">Legal <span style="font-size:10px; color:#a79f8e; font-weight:700; background:rgba(255,255,255,0.05); margin-left:6px; padding:1px 6px; border-radius:2px;">Medio</span></div>
              <p style="font-size:13px; color:#a79f8e; margin:0; line-height:1.45;">Protección de datos (Ley 25.326) y convergencia hacia estándares europeos RGPD.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .s06-card {
    transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }
  .s06-card:hover {
    transform: translateY(-2px);
    border-color: rgba(255,247,205,0.45);
    background: rgba(255,247,205,0.08);
  }
</style>

<script>
  import { animate } from "motion";
  const slide = document.getElementById("slide-06");

  function runSlide06Animations() {
    if (!slide) return;

    const label = slide.querySelector(".s06-label");
    if (label) animate(label, { opacity: [0, 1], x: [-20, 0] }, { duration: 0.4 });

    const title = slide.querySelector(".s06-title");
    if (title) animate(title, { opacity: [0, 1], x: [-20, 0] }, { duration: 0.5, delay: 0.1, ease: [0.16, 1, 0.3, 1] });

    // Cards entran con suave efecto diagonal
    const cards = slide.querySelectorAll(".s06-card");
    const dirs = [[-25, -10], [25, -10], [-25, 10], [25, 10]];
    cards.forEach((card, i) => {
      animate(
        card,
        { opacity: [0, 1], x: [dirs[i][0], 0], y: [dirs[i][1], 0] },
        { duration: 0.55, delay: 0.2 + i * 0.1, ease: [0.16, 1, 0.3, 1] }
      );
    });
  }

  slide?.addEventListener("slide:enter", runSlide06Animations);
  if (slide?.closest("section.present") || slide?.classList.contains("present")) {
    runSlide06Animations();
  }
</script>
