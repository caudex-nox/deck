---
---
<!-- Slide 06 — PEST Macroentorno con fuentes grandes, texto mínimo y badges pulsantes -->
<section id="slide-06">
  <div class="slide-content" style="background:#121212; width:100%; height:100%; overflow:hidden; font-family:'Inter',sans-serif;">
    <div style="position:relative; width:100%; height:100%; display:flex; align-items:center; justify-content:center;">

      <div style="position:absolute; top:0; left:0; right:0; height:3px; background: linear-gradient(to right, transparent, #FFF7CD 40%, transparent);"></div>
      <div style="position:absolute; top:28px; right:48px; font-size:12px; color:rgba(167,159,142,0.4); font-weight:600; letter-spacing:0.15em;">07 / 21</div>

      <div style="position:relative; z-index:10; max-width:1020px; width:100%; padding:0 64px;">
        <p class="s06-label" style="font-size:12px; color:#FFF7CD; letter-spacing:0.25em; text-transform:uppercase; font-weight:700; margin:0 0 14px 0; opacity:0;">Análisis PEST · Macroentorno</p>
        <h2 class="s06-title" style="font-size:44px; font-weight:800; color:#FFF7CD; margin:0 0 32px 0; letter-spacing:-0.02em; opacity:0; line-height:1.1;">Contexto que <span style="color:#FAF0B5;">nos impulsa</span></h2>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:18px;">

          <!-- Tecnológica -->
          <div class="s06-card" style="padding:24px 22px; background:rgba(255,247,205,0.06); border:1px solid rgba(255,247,205,0.28); display:flex; gap:18px; align-items:center; border-radius:4px; opacity:0;">
            <div class="s06-badge" style="min-width:48px; height:48px; background:#FFF7CD; display:flex; align-items:center; justify-content:center; font-size:22px; font-weight:900; color:#121212; flex-shrink:0; border-radius:4px;">T</div>
            <div>
              <div style="font-size:16px; font-weight:800; color:#FFF7CD; margin-bottom:4px;">Tecnológica <span style="font-size:11px; color:#121212; background:#FFF7CD; font-weight:800; margin-left:8px; padding:2px 7px; border-radius:2px;">Muy Alto</span></div>
              <p style="font-size:14px; color:#a79f8e; margin:0; line-height:1.4;">Auge de IA y aceleración en demanda de software.</p>
            </div>
          </div>

          <!-- Económica -->
          <div class="s06-card" style="padding:24px 22px; background:rgba(255,255,255,0.035); border:1px solid rgba(255,247,205,0.22); display:flex; gap:18px; align-items:center; border-radius:4px; opacity:0;">
            <div class="s06-badge" style="min-width:48px; height:48px; background:rgba(255,247,205,0.15); border:1px solid rgba(255,247,205,0.35); display:flex; align-items:center; justify-content:center; font-size:22px; font-weight:900; color:#FFF7CD; flex-shrink:0; border-radius:4px;">E</div>
            <div>
              <div style="font-size:16px; font-weight:800; color:#FFF7CD; margin-bottom:4px;">Económica <span style="font-size:11px; color:#FAF0B5; font-weight:700; background:rgba(255,247,205,0.12); margin-left:8px; padding:2px 7px; border-radius:2px;">Alto</span></div>
              <p style="font-size:14px; color:#a79f8e; margin:0; line-height:1.4;">Costos en dólares impulsan el desarrollo local en pesos.</p>
            </div>
          </div>

          <!-- Cultural -->
          <div class="s06-card" style="padding:24px 22px; background:rgba(255,255,255,0.035); border:1px solid rgba(255,247,205,0.22); display:flex; gap:18px; align-items:center; border-radius:4px; opacity:0;">
            <div class="s06-badge" style="min-width:48px; height:48px; background:rgba(255,247,205,0.15); border:1px solid rgba(255,247,205,0.35); display:flex; align-items:center; justify-content:center; font-size:22px; font-weight:900; color:#FFF7CD; flex-shrink:0; border-radius:4px;">C</div>
            <div>
              <div style="font-size:16px; font-weight:800; color:#FFF7CD; margin-bottom:4px;">Cultural <span style="font-size:11px; color:#FAF0B5; font-weight:700; background:rgba(255,247,205,0.12); margin-left:8px; padding:2px 7px; border-radius:2px;">Alto</span></div>
              <p style="font-size:14px; color:#a79f8e; margin:0; line-height:1.4;">Cultura digital remota y modernización institucional.</p>
            </div>
          </div>

          <!-- Legal -->
          <div class="s06-card" style="padding:24px 22px; background:rgba(255,255,255,0.025); border:1px solid rgba(255,247,205,0.12); display:flex; gap:18px; align-items:center; border-radius:4px; opacity:0;">
            <div class="s06-badge" style="min-width:48px; height:48px; background:rgba(255,255,255,0.06); border:1px solid rgba(255,247,205,0.18); display:flex; align-items:center; justify-content:center; font-size:22px; font-weight:900; color:#a79f8e; flex-shrink:0; border-radius:4px;">L</div>
            <div>
              <div style="font-size:16px; font-weight:800; color:#a79f8e; margin-bottom:4px;">Legal <span style="font-size:11px; color:#a79f8e; font-weight:700; background:rgba(255,255,255,0.06); margin-left:8px; padding:2px 7px; border-radius:2px;">Medio</span></div>
              <p style="font-size:14px; color:#a79f8e; margin:0; line-height:1.4;">Protección de datos (Ley 25.326) y estándares RGPD.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .s06-card {
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease;
  }
  .s06-card:hover {
    transform: translateY(-3px);
    border-color: rgba(255,247,205,0.55);
    background: rgba(255,247,205,0.09);
  }
</style>

<script>
  import { animate } from "motion";
  const slide = document.getElementById("slide-06");
  let badgePulses = [];

  function runSlide06Animations() {
    if (!slide) return;

    badgePulses.forEach(a => a.stop());
    badgePulses = [];

    const label = slide.querySelector(".s06-label");
    if (label) animate(label, { opacity: [0, 1], x: [-20, 0] }, { duration: 0.4 });

    const title = slide.querySelector(".s06-title");
    if (title) animate(title, { opacity: [0, 1], x: [-20, 0] }, { duration: 0.5, delay: 0.1, ease: [0.16, 1, 0.3, 1] });

    // Cards entran con suave efecto diagonal
    const cards = slide.querySelectorAll(".s06-card");
    const dirs = [[-25, -10], [25, -10], [-25, 10], [25, 10]];
    cards.forEach((card, i) => {
      animate(
        card,
        { opacity: [0, 1], x: [dirs[i][0], 0], y: [dirs[i][1], 0] },
        { duration: 0.55, delay: 0.2 + i * 0.1, ease: [0.16, 1, 0.3, 1] }
      );
    });

    // Pulso lumínico continuo en los badges T, E, C, L
    const badges = slide.querySelectorAll(".s06-badge");
    badges.forEach((b, i) => {
      setTimeout(() => {
        if (!slide.classList.contains("present") && !slide.closest("section.present")) return;
        const p = animate(
          b,
          {
            boxShadow: [
              "0 0 0px transparent",
              "0 0 16px rgba(255, 247, 205, 0.4)",
              "0 0 0px transparent"
            ],
            scale: [1, 1.05, 1]
          },
          {
            duration: 3,
            delay: i * 0.5,
            repeat: Infinity,
            ease: "easeInOut"
          }
        );
        badgePulses.push(p);
      }, 750);
    });
  }

  function stopSlide06Animations() {
    badgePulses.forEach(a => a.stop());
    badgePulses = [];
  }

  slide?.addEventListener("slide:enter", runSlide06Animations);
  slide?.addEventListener("slide:leave", stopSlide06Animations);
  if (slide?.closest("section.present") || slide?.classList.contains("present")) {
    runSlide06Animations();
  }
</script>
